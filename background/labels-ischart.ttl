PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX reg: <http://purl.org/linked-data/registry#>
PREFIX schema: <https://schema.org/>
PREFIX sh: <http://www.w3.org/ns/shacl#>

<http://resource.geosciml.org/classifier/ics/ischart/CMYK>
    schema:name "CMYK Colour Scheme" ;
.

<http://resource.geosciml.org/classifier/ics/ischart/RGB>
    schema:name "RGB Colour Schem" ;
.

<http://resource.geosciml.org/classifier/ics/ischart/RGBHex>
    schema:name "RGB Hex Colour Schem" ;
.

<http://resource.geosciml.org/classifier/ics/ischart/ccgmShortCode>
    schema:name "CCGM Short Code" ;
.

<http://resource.geosciml.org/vocabulary/timescale/gts2020>
    schema:name "Geologic Timescale, 2020" ;
.

rdfs:isDefinedBy
    schema:name "is defined by" ;
.

sh:order
    schema:name "order" ;
.

<http://resource.geosciml.org/ontology/timescale/gts#rank>
    schema:name "rank" ;
.
