:direct-reduced-iron
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "DRI"@en ,
        "sponge iron"@en ;
    skos:broader :iron ;
    skos:definition "Direct reduced iron (DRI) is produced from the direct reduction of iron ore (in the form of lumps, pellets, or fines) into iron by a reducing gas or elemental carbon produced from natural gas or coal. There are several processes for direct reduction of iron ore: gas-based shaft furnace processes; gas-based fluidized bed processes; coal based rotary kiln furnaces. Direct reduction refers to solid-state processes which reduce iron oxides to metallic iron at temperatures below the melting point of iron. DRI is not useful by itself but can be processed to create wrought iron or steel."@en ;
    skos:historyNote "Definition adapted from Wikipedia and International Iron Metallics Association's website." ;
    skos:inScheme cs: ;
    skos:prefLabel "iron - direct reduced iron (DRI)"@en ;
    schema:citation
        "https://en.wikipedia.org/wiki/Direct_reduced_iron"^^xsd:anyURI ,
        "https://www.metallics.org/dri-production.html"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:dysprosium
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broadMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/HREE> ,
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/rareearthelement> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/HREE> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/rareearthelement> ,
        <https://linked.data.gov.au/def/geo-commodities/heavy-rare-earth-element> ,
        <https://linked.data.gov.au/def/geo-commodities/rare-earth-element> ;
    skos:broader :heavy-rare-earth-elements ;
    skos:definition "Dysprosium is the chemical element with the symbol Dy and atomic number 66. It is a rare earth element (REE) in the lanthanide series with a metallic silver lustre. Dysprosium is never found in nature as a free element, though, like other lanthanides, it is found in various minerals, such as xenotime. Naturally occurring dysprosium is composed of seven isotopes, the most abundant of which is ¹⁶⁴Dy."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/dysprosium> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/dysprosium> ,
        <https://linked.data.gov.au/def/geo-commodities/dysprosium> ;
    skos:inScheme cs: ;
    skos:prefLabel "dysprosium"@en ;
    schema:citation "https://en.wikipedia.org/wiki/Dysprosium"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

