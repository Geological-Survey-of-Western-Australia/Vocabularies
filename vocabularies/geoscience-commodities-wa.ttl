    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:pyrite
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "fool's gold"@en ,
        "iron pyrite"@en ,
        "mundic"@en ;
    skos:broader :mineral-commodities ;
    skos:definition "A common, pale bronze or brass yellow, cubic mineral with the chemical formula FeS₂. It is dimorphous with marcasite, and often contains small amounts of other metals. Pyrite has a brilliant metallic lustre and an absence of cleavage, and has been mistaken for gold (which is softer and heavier). It commonly crystallizes in cubes, octahedrons or pyritohedrons, and it also occurs in shapeless grains and masses. Pyrite is the most widespread and abundant of the sulfide minerals and occurs in all kinds of rocks, such as in nodules in sedimentary rocks and coal seams or as a common vein material associated with many different minerals. Pyrite is an important ore of sulfur, less so of iron, and is burned in making sulfur dioxide and sulfuric acid; it is sometimes mined for the associated gold and copper."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/pyrite> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/pyrite> ,
        <https://linked.data.gov.au/def/geo-commodities/pyrite> ;
    skos:inScheme cs: ;
    skos:prefLabel "pyrite"@en ;
    schema:citation
        "http://en.wikipedia.org/wiki/Pyrite"^^xsd:anyURI ,
        "https://glossary.americangeosciences.org/term/pyrite"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:pyrophyllite
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "pencil stone"@en ;
    skos:broader :mineral-commodities ;
    skos:definition "A white, grey, blue, green or brown mineral occurring in monoclinic and triclinic polytypes with the chemical formula Al₂Si₄O₁₀(OH)₂. It resembles talc and occurs in a foliated form or in compact masses in quartz veins, granites and especially metamorphic rocks. The compact variety of pyrophyllite is used for slate pencils and tailors' chalk (French chalk) and is carved into small images and ornaments of various kinds. Pyrophyllite is easily machinable and has excellent thermal stability, so it is added to clay to reduce thermal expansion when firing, but it has many other industry uses when combined with other compounds, such as in insecticide and for making bricks. Pyrophyllite is also widely used in high-pressure experiments, both as a gasket material and as a pressure-transmitting medium."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/pyrophyllite> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/pyrophyllite> ,
        <https://linked.data.gov.au/def/geo-commodities/pyrophyllite> ;
    skos:inScheme cs: ;
    skos:prefLabel "pyrophyllite"@en ;
    schema:citation
        "https://en.wikipedia.org/wiki/Pyrophyllite"^^xsd:anyURI ,
        "https://glossary.americangeosciences.org/term/pyrophyllite"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

