    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:nickel-equivalent
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broader :metal-equivalents ;
    skos:definition "Nickel equivalent (NiEq) is a calculated parameter used in metallurgy to predict the phase stability of stainless steels and other alloys, commonly in conjunction with a Chromium equivalent (CrEq). It helps in understanding the balance between austenite and ferrite phases (as well as martensite and micture of all these) in the material."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "nickel equivalent"@en ;
    schema:citation
        "https://bssa.org.uk/bssa_articles/the-schaeffler-and-delong-diagrams-for-predicting-ferrite-levels-in-austenitic-stainless-steel-welds/"^^xsd:anyURI ,
        "https://materialwelding.com/schaeffler-diagram-and-its-practical-uses/"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:nickel-sulfate
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "Ni sulfate"@en ,
        "Ni sulphate"@en ,
        "nickel sulphate"@en ,
        "nickel(II) sulphate"@en ,
        "nickelous sulfate"@en ,
        "nickelous sulphate"@en ;
    skos:broader :mineral-commodities ;
    skos:definition "An inorganic compound with the formula NiSO₄(H₂O)₆. This highly soluble blue–green coloured salt is a common source of the Ni²⁺ ion for electroplating. The salt is usually obtained as a byproduct of copper refining. It is also produced by dissolution of nickel metal or nickel oxides in sulfuric acid."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "nickel sulfate"@en ;
    schema:citation "https://en.wikipedia.org/wiki/Nickel(II)_sulfate"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:niobium
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "Nb"@en ;
    skos:broader :mineral-commodities ;
    skos:definition "A chemical element with chemical symbol Nb and atomic number 41. It is a light grey, crystalline and ductile transition metal. Niobium oxidizes in Earth's atmosphere very slowly, hence its application in jewellery as a hypoallergenic alternative to nickel. Niobium is found in the minerals pyrochlore and columbite and is mainly used in high-grade structural steel and superalloys."@en ;
    skos:exactMatch
