:lpg-butane
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "Liquefied Petroleum Gas (LPG) - Butane"@en ,
        "butane"@en ,
        "n-butane"@en ;
    skos:broadMatch <https://linked.data.gov.au/def/geo-commodities/lpg> ;
    skos:broader :liquefied-petroleum-gas ;
    skos:definition "An alkane with the chemical formula C₄H₁₀. Butane is a highly flammable, colourless, easily liquefied gas that quickly vaporises at room temperature and pressure. Butane is one of a group of liquefied petroleum gases (LPG) and burns more cleanly than gasoline and coal."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "LPG - butane"@en ;
    schema:citation "https://en.wikipedia.org/wiki/Butane"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:lpg-propane
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "Liquefied Petroleum Gas (LPG) - Propane"@en ,
        "propane"@en ;
    skos:broadMatch <https://linked.data.gov.au/def/geo-commodities/lpg> ;
    skos:broader :liquefied-petroleum-gas ;
    skos:definition "An alkane with the chemical formula C₃H₈. It is a gas at standard temperature and pressure, but compressible to a transportable liquid. A byproduct of natural gas processing and petroleum refining, it is commonly used as a fuel in domestic and industrial applications and in low-emissions public transportation. Propane has lower volumetric energy density, but higher gravimetric energy density and burns more cleanly than gasoline and coal."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "LPG - propane"@en ;
    schema:citation "https://en.wikipedia.org/wiki/Propane"^^xsd:anyURI ;
