.

:leucoxene
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broader :mineral-commodities ;
    skos:definition "A fine, granular alteration/weathering product without a defined crystal structure and consisting of a mixture of Fe–Ti oxides, including titanite, perovskite, titanian magnetite, but especially ilmenite. Most leucoxene is anatase or rutile. It varies in colour from yellow to brown. Leucoxene is observed in some igneous and metamorphic rocks, as well as in iron ore deposits. It is a valuable mineral in heavy mineral sands, where it is commonly used as feedstock for the titanium dioxide chloride process used to separate titanium from its ores."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/leucoxene> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/leucoxene> ,
        <https://linked.data.gov.au/def/geo-commodities/leucoxene> ;
    skos:inScheme cs: ;
    skos:prefLabel "leucoxene"@en ;
    schema:citation
        "http://en.wikipedia.org/wiki/Leucoxene"^^xsd:anyURI ,
