        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/hematiteore> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/hematite-gemstone> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/hematiteore> ,
        <https://linked.data.gov.au/def/geo-commodities/hematite-gemstone> ,
        <https://linked.data.gov.au/def/geo-commodities/hematite-ore> ;
    skos:narrower
