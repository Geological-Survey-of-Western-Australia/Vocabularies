        "https://glossary.americangeosciences.org/term/cassiterite"^^xsd:anyURI ,
        "https://www.mindat.org/min-917.html"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

