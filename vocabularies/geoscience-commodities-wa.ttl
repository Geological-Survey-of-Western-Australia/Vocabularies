:holmium
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broadMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/HREE> ,
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/rareearthelement> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/HREE> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/rareearthelement> ,
        <https://linked.data.gov.au/def/geo-commodities/heavy-rare-earth-element> ,
        <https://linked.data.gov.au/def/geo-commodities/rare-earth-element> ;
    skos:broader :heavy-rare-earth-elements ;
    skos:definition "Holmium is a chemical element with the symbol Ho and atomic number 67. It is a rare earth element (REE) and the eleventh member of the lanthanide series. It is a relatively soft, silvery, fairly corrosion-resistant and malleable metal. Like a lot of other lanthanides, holmium is too reactive to be found in native form, as pure holmium slowly forms a yellowish oxide coating when exposed to air. In nature, holmium occurs together with the other rare-earth metals (like thulium). It is a relatively rare lanthanide, making up 1.4 parts per million of the Earth's crust, an abundance similar to tungsten. Like many other lanthanides, holmium is found in the minerals monazite and gadolinite and is usually commercially extracted from monazite using ion-exchange techniques. The primary applications of holmium are in magnets, lasers and for spectrometer calibration."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/holmium> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/holmium> ,
        <https://linked.data.gov.au/def/geo-commodities/holmium> ;
    skos:inScheme cs: ;
    skos:prefLabel "holmium"@en ;
    schema:citation "https://en.wikipedia.org/wiki/Holmium"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:holmium-oxide
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "Ho oxide"@en ,
        "Ho(III) oxide"@en ,
        "Ho(III)-oxide"@en ,
        "Ho-oxide"@en ,
        "holmia"@en ,
        "holmium(III) oxide"@en ,
        "holmium-oxide"@en ;
    skos:broadMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/heavyrareearthoxide> ,
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/rareearthoxide> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/heavyrareearthoxide> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/rareearthoxide> ,
        <https://linked.data.gov.au/def/geo-commodities/heavy-rare-earth-oxide> ,
        <https://linked.data.gov.au/def/geo-commodities/rare-earth-oxide> ;
    skos:broader :rare-earth-oxides ;
    skos:definition "Holmium oxide is a chemical compound of the rare earth element holmium and oxygen with a chemical formula of Ho₂O₃. Together with dysprosium oxide (Dy₂O₃), holmium oxide is one of the most powerfully paramagnetic substances known. The oxide occurs as a component of the related erbium oxide mineral. Holmium oxide is used in making specialty coloured glasses. Glass containing holmium oxide and holmium oxide solutions have a series of sharp optical absorption peaks in the visible spectral range. They are therefore traditionally used as a convenient calibration standard for optical spectrophotometers."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "holmium oxide"@en ;
    schema:citation "https://en.wikipedia.org/wiki/Holmium(III)_oxide"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:hydroenergy
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "hydro energy"@en ;
    skos:broadMatch <https://linked.data.gov.au/def/geo-commodities/energy-resources> ;
    skos:broader :power-energy ;
    skos:definition "The exploitation of the kinetic energy of moving water such as rivers and streams or through stored water facilities such as dams  to produce electricity. It includes a number of generation and storage technologies, predominantly hydroelectricity and Pumped Hydro Energy Storage (PHES). Hydropower is one of the oldest and most mature energy technologies and has been used in various forms for thousands of years."@en ;
    skos:exactMatch <https://linked.data.gov.au/def/geo-commodities/hydro-power> ;
    skos:historyNote "Definition from the Australian Renewable Energy Agency (ARENA) and Geological Survey of Queensland Geoscience Commodities vocabulary." ;
    skos:inScheme cs: ;
    skos:prefLabel "hydroenergy"@en ;
    schema:citation
        "https://arena.gov.au/renewable-energy/pumped-hydro-energy-storage/"^^xsd:anyURI ,
        "https://vocabs.gsq.digital/v/vocab/def:geo-commodities/g-cmmdts:hydro-power"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:hydrogen-black-brown
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "brown/black hydrogen"@en ;
    skos:broader :hydrogen-manufactured ;
    skos:definition "Brown hydrogen (made from brown coal) and black hydrogen (made from black coal) are produced via gasification. It's an established process used in many industries that converts carbon-rich materials into hydrogen and carbon dioxide. As a result, gasification releases those byproducts into the atmosphere."@en ;
    skos:historyNote "Definition from CSIRO's website." ;
    skos:inScheme cs: ;
    skos:prefLabel "hydrogen - black/brown"@en ;
    schema:citation "https://www.csiro.au/en/news/All/Articles/2021/May/green-blue-brown-hydrogen-explained"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:hydrogen-blue
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "blue hydrogen"@en ;
    skos:broader :hydrogen-manufactured ;
    skos:definition "Blue hydrogen is produced using a process called ‘steam reforming’, which uses steam to separate hydrogen from natural gas, oil or coal, while simultaneously capturing and storing greenhouse gases emissions released by the process."@en ;
    skos:historyNote "Definition from CSIRO's website." ;
    skos:inScheme cs: ;
    skos:prefLabel "hydrogen - blue"@en ;
    schema:citation "https://www.csiro.au/en/news/All/Articles/2021/May/green-blue-brown-hydrogen-explained"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:hydrogen-green
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "green hydrogen"@en ;
    skos:broader :hydrogen-manufactured ;
    skos:definition "Green hydrogen (GH2 or GH₂) is hydrogen produced by the electrolysis of water, using a method that does not produce greenhouse gases (GHG) emissions. As the name suggests, its production is sustainable and environmentally friendly. Green hydrogen is most commonly produced using an electrolyser that uses electricity to split water into hydrogen and oxygen. The key to this method of producing green hydrogen is that the electricity that powers the electrolyser comes from renewable sources, such as wind, solar, which have no associated GHG emissions; there are also pathways to produce green hydrogen from waste biomass."@en ;
    skos:historyNote "Definition from CSIRO's website." ;
    skos:inScheme cs: ;
    skos:prefLabel "hydrogen - green (GH2)"@en ;
    schema:citation
        "https://en.wikipedia.org/wiki/Green_hydrogen"^^xsd:anyURI ,
        "https://www.csiro.au/en/news/All/Articles/2021/May/green-blue-brown-hydrogen-explained"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:hydrogen-grey
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "grey hydrogen"@en ;
    skos:broader :hydrogen-manufactured ;
    skos:definition "Grey hydrogen is extracted from natural gas using steam reforming (i.e. using steam to separate hydrogen from natural gas), but unlike blue hydrogen, relevant technologies don't capture resulting emissions; these are released into the atmosphere."@en ;
    skos:historyNote "Definition from CSIRO's website." ;
    skos:inScheme cs: ;
    skos:prefLabel "hydrogen - grey"@en ;
    schema:citation "https://www.csiro.au/en/news/All/Articles/2021/May/green-blue-brown-hydrogen-explained"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:hydrogen-orange
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broader :hydrogen-natural ;
    skos:definition "Orange hydrogen is a natural hydrogen derived from subsurface stimulation of natural production of H₂ by water–iron reaction (hence the colour orange) via in situ injection of water into identified reactive formations and collection of  the hydrogen-saturated water from recovery wells surrounding the injection point, while simultaneous sequestering CO₂."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "hydrogen - orange"@en ;
    schema:citation "https://www.nature.com/articles/s41561-022-01043-9"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:ilmenite
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broader :mineral-commodities ;
    skos:definition "An iron-black, opaque metallic to submetallic mineral of the ilmenite group with a chemical formula of Fe²⁺TiO₃. Ilmenite occurs as a common accessory mineral in igneous rocks and is concentrated in placer deposits. Ilmenite is the most important ore of titanium and the main source of titanium dioxide, which is used in paints, printing inks, fabrics, plastics, paper, sunscreen, food and cosmetics."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/ilmenite> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/ilmenite> ,
        <https://linked.data.gov.au/def/geo-commodities/ilmenite> ;
    skos:inScheme cs: ;
    skos:prefLabel "ilmenite"@en ;
    schema:citation
        "https://en.wikipedia.org/wiki/Ilmenite"^^xsd:anyURI ,
        "https://glossary.americangeosciences.org/term/ilmenite"^^xsd:anyURI ,
        "https://www.mindat.org/min-2013.html#autoanchor16"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:indium
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broader :mineral-commodities ;
    skos:definition "A chemical element with symbol In and atomic number 49. This rare, very soft, malleable and easily fusible other heavy metal is chemically similar to gallium and thallium, and shows intermediate properties between these two. Indium is a minor component in zinc sulfide ores and is produced as a byproduct of zinc refinement. It is most notably used in the semiconductor industry, in low-melting-point metal alloys such as solders, in soft-metal high-vacuum seals, and in the production of transparent conductive coatings of indium tin oxide on glass. Indium is considered a technology-critical element."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/indium> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/indium> ,
        <https://linked.data.gov.au/def/geo-commodities/indium> ;
    skos:inScheme cs: ;
    skos:prefLabel "indium"@en ;
    schema:citation
        "https://en.wikipedia.org/wiki/Indium"^^xsd:anyURI ,
        "https://linked.data.gov.au/def/geo-commodities/indium"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:iron-calcined
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broader :iron ;
    skos:definition "Iron oxides formed by the treatment of iron ore by the calcination process, which involves heating to high temperatures to remove impurities and volatiles (e.g. CO₂)."@en ;
    skos:historyNote "Definition adapted from Wikipedia and Celikdemir (2018; Celikdemir, M, Sarikaya, M, Depci, T, Aydogmus, R and Yucel, A 2018, Calcination and pelletizing of siderite ore, in Iron Ores and Iron Oxide Materials, InTech 2018, doi.org/10.5772/intechopen.72808)." ;
    skos:inScheme cs: ;
    skos:prefLabel "iron - calcined"@en ;
    schema:citation
        "https://en.wikipedia.org/wiki/Calcination"^^xsd:anyURI ,
        "https://www.intechopen.com/chapters/58482"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:iron-ore
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broader :mineral-commodities ;
    skos:definition "Rocks and minerals from which metallic iron can be economically extracted. The ores are usually rich in iron oxides and vary in colour from dark grey, bright yellow and deep purple to rusty red. The iron itself is usually found in the form of magnetite (Fe₃O₄), hematite Fe₂O₃), goethite (FeO(OH)), limonite (FeO(OH).n(H₂O)) or siderite (FeCO₃). Ores carrying very high quantities of hematite or magnetite (greater than ~60% iron) are known as 'natural ore' or 'direct shipping ore', meaning they can be fed directly into iron-making blast furnaces. Iron ore is the raw material used to make pig iron, which is one of the main raw materials to make steel. 98% of mined iron ore is used to make steel."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/ironore> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/ironore> ,
        <https://linked.data.gov.au/def/geo-commodities/iron-ore> ;
    skos:inScheme cs: ;
    skos:prefLabel "iron ore"@en ;
    schema:citation
        "http://en.wikipedia.org/wiki/Iron_ore"^^xsd:anyURI ,
        "https://glossary.americangeosciences.org/term/ironore"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:iron-ore-pellets
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broadMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/ironore> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/ironore> ,
        <https://linked.data.gov.au/def/geo-commodities/iron-ore> ;
    skos:broader :iron ;
    skos:definition "Spheres of typically 6–16 mm (0.24 – 0.63 in) to be used as raw material for blast furnaces. They typically contain 64–72% Fe and various additional material adjusting the chemical composition and the metallurgic properties of the pellets. Typically, limestone, dolomite and olivine are added and bentonite is used as binder."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "iron - iron ore pellets"@en ;
    schema:citation "https://en.wikipedia.org/wiki/Pelletizing"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:iron-specimen
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broader :iron ;
    skos:definition "A specimen of a primary iron-bearing mineral (e.g. hematite, goethite), naturally occurring iron ore, or derived product that has been collected, preserved and usually curated as part of a mineral collection."@en ;
    skos:historyNote "Compiled by the Geological Survey of western Australia." ;
    skos:inScheme cs: ;
    skos:prefLabel "iron specimen"@en ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

