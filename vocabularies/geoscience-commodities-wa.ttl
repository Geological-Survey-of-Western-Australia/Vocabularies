    skos:inScheme cs: ;
    skos:prefLabel "lithium"@en ;
    schema:citation "https://en.wikipedia.org/wiki/Lithium"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:lithium-oxide
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "Li oxide"@en ,
        "Li-oxide"@en ,
        "dilithium monoxide"@en ,
        "dilithium oxide"@en ,
        "kickerite"@en ,
        "lithia"@en ;
    skos:broader :mineral-commodities ;
    skos:definition "An inorganic chemical compound with the chemical formula Li₂O. It is a white solid. Lithium oxide is used as a flux in ceramic glazes and reacts with water and steam, forming lithium hydroxide and should be isolated from them."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/lithiumoxide> ,
