.

:tin-oxide
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "Sn(IV) oxide"@en ,
        "Sn(IV)-oxide"@en ,
        "stannic oxide"@en ,
        "tin dioxide"@en ,
        "tin(IV) oxide"@en ,
        "tin(IV)-oxide"@en ;
    skos:broader :mineral-commodities ;
    skos:definition "Tin oxide is the inorganic compound with the formula SnO₂. The mineral form of tin oxide is called cassiterite, and this is the main ore of tin. With many other names, this oxide of tin is an important material in tin chemistry. It is a colourless, diamagnetic, amphoteric solid. In conjunction with vanadium oxide, it is used as a catalyst for the oxidation of aromatic compounds in the synthesis of carboxylic acids and acid anhydrides. Tin oxide is also used in ceramic glazes, dyes, for polishing, glass coatings and gas sensing."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/tinoxide> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/tinoxide> ;
    skos:inScheme cs: ;
    skos:prefLabel "tin oxide"@en ;
    schema:citation "https://en.wikipedia.org/wiki/Tin(IV)_oxide"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:titanomagnetite
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "Ti-magnetite"@en ,
        "mogensenite"@en ,
        "titanian magnetite"@en ,
        "titaniferous magnetite"@en ,
        "titanium-bearing magnetite"@en ;
    skos:broader :mineral-commodities ;
    skos:definition "A titaniferous variety of magnetite with the chemical formula (Fe³⁺,Fe²⁺,Ti⁴⁺)₂[Fe²⁺O₄]. It is strictly a homogeneous solid solution of magnetite with ulvöspinel (Fe₂TiO₄), with Ti⁴⁺ occupying only octahedral sites of the magnetite structure. Like magnetite, titanomagnetites are cubic spinels where the substitution of Ti for Fe occurs by replacing 2Fe³⁺ for Ti⁴⁺+Fe²⁺. Many intrinsic magnetic and physical properties of titanomagnetites, including saturation magnetization, Curie temperature, magnetocrystalline anisotropy, magnetostriction, and electrical conductivity depend on a variety of interrelated crystal chemical properties. Titanomagnetite concentrate is used in the production of vanadium pig iron and titanium slag, abrasives and refractory products and pigments."@en ;
    skos:exactMatch <https://linked.data.gov.au/def/geo-commodities/titanomagnetite> ;
    skos:inScheme cs: ;
    skos:prefLabel "titanomagnetite"@en ;
    schema:citation
        "https://glossary.americangeosciences.org/term/titanomagnetite"^^xsd:anyURI ,
        "https://taylorandfrancis.com/knowledge/Engineering_and_technology/Materials_science/Titanomagnetite/"^^xsd:anyURI ,
        "https://www.mindat.org/min-3978.html"^^xsd:anyURI ,
        "https://www.phosagro.com/production/others/"^^xsd:anyURI ,
        "https://www.sciencedirect.com/topics/earth-and-planetary-sciences/titanomagnetite"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:tourmaline-dravite
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
