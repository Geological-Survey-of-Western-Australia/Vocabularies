        :limestone-metallurgical ,
        :limestone-travertine ;
    skos:prefLabel "limestone"@en ;
    schema:citation
        "https://en.wikipedia.org/wiki/Limestone"^^xsd:anyURI ,
        "https://glossary.americangeosciences.org/term/limestone"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:aggregate
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "ballast"@en ,
        "gravel"@en ;
    skos:broader :industrial-commodities ;
    skos:definition "A broad grouping of hard, inert, coarse- to medium-grained materials including sand, gravel, crushed rock and mine waste. Aggregate is commonly used for mixing with a cementing or bituminous material to form concrete, mortar, or plaster; or used alone, as in railroad ballast or graded fill; the term sometimes includes rock material used as chemical or metallurgical fluxstone, or filtration medium."@en ;
