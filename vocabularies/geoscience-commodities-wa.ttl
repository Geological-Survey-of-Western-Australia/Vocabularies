    skos:inScheme cs: ;
    skos:prefLabel "niobium pentoxide"@en ;
    schema:citation "https://en.wikipedia.org/wiki/Niobium_pentoxide"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:nuclear-energy
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "nuclear power"@en ;
    skos:broader :power-energy ;
    skos:definition "Nuclear energy is a form of energy released from the nucleus (or core) of atoms, which is made up of protons and neutrons. Nuclear power is the use of nuclear reactions that produce thermal energy which is used to power steam turbines to produce electricity. Nuclear energy/power can be produced by: (a) fission, when nuclei of atoms split into several parts, (b) fusion, when nuclei fuse together, and (c) decay. The nuclear energy harnessed around the world today to produce electricity is largely through nuclear fission of uranium and plutonium in nuclear power plants, while technology to generate electricity from nuclear fusion is at the research and development phase; nuclear decay processes are used in niche applications such as radioisotope thermoelectric generators in some space probes such as Voyager 2."@en ;
    skos:historyNote "Definition from the International Atomic Energy Agency and Wikipedia." ;
    skos:inScheme cs: ;
    skos:prefLabel "nuclear energy"@en ;
    schema:citation
        "https://en.wikipedia.org/wiki/Nuclear_power"^^xsd:anyURI ,
        "https://www.iaea.org/newscenter/news/what-is-nuclear-energy-the-science-of-nuclear-power"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:olivine
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broader :mineral-commodities ;
    skos:definition "An olive-green, greyish green or brown orthorhombic mineral with the chemical formula (Mg,Fe)₂SiO₄. It consists of the isomorphous solid-solution series forsterite–fayalite. Olivine is a common rock-forming mineral of basic, ultrabasic and low-silica igneous rocks (gabbro, basalt, peridotite, dunite). It crystallizes early from a magma, weathers readily at the Earth's surface and metamorphoses to serpentine. Olivine is used as a substitute for dolomite in steel works, to cast objects in aluminium production and is a candidate for carbon sequestration. Gem-quality olivine is used as a gemstone called peridot."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/olivine> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/olivine> ,
        <https://linked.data.gov.au/def/geo-commodities/olivine> ;
    skos:inScheme cs: ;
    skos:narrowMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/olivine-gemstone> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/olivine-gemstone> ,
        <https://linked.data.gov.au/def/geo-commodities/olivine-gemstone> ;
    skos:prefLabel "olivine"@en ;
    schema:citation
        "https://en.wikipedia.org/wiki/Olivine#Uses"^^xsd:anyURI ,
        "https://glossary.americangeosciences.org/term/olivine"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

