:liquefied-petroleum-gas
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "LP gas"@en ,
        "LPG"@en ,
        "autogas"@en ;
    skos:broader :petroleum ;
    skos:definition "A fuel gas which contains a flammable mixture of hydrocarbon gases, specifically propane, propylene, butylene, isobutane and n-butane. Liquefied petroleum gas (LPG) is used as a fuel gas in heating appliances, cooking equipment and vehicles. It is increasingly used as an aerosol propellant and a refrigerant, replacing chlorofluorocarbons in an effort to reduce damage to the ozone layer. When specifically used as a vehicle fuel, it is often referred to as autogas or even just as gas."@en ;
    skos:exactMatch <https://linked.data.gov.au/def/geo-commodities/lpg> ;
    skos:inScheme cs: ;
    skos:narrower
        :lpg-butane ,
        :lpg-propane ;
    skos:prefLabel "liquefied petroleum gas (LPG)"@en ;
    schema:citation "https://en.wikipedia.org/wiki/Liquefied_petroleum_gas"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:magnesite
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "giobertite"@en ;
    skos:broader :mineral-commodities ;
    skos:definition "A white to greyish, yellow, or brown rhombohedral mineral with the chemical formula MgCO₃. It is isomorphous with siderite. Magnesite is generally found as earthy masses or irregular veins resulting from the alteration of dolomite rocks, or of rocks rich in magnesium silicates, by magmatic solutions. It is used chiefly in making magnesia and refractory (heat resistant) materials used as a lining in blast furnaces, kilns and incinerators."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/magnesite> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/magnesite> ,
        <https://linked.data.gov.au/def/geo-commodities/magnesite> ;
    skos:inScheme cs: ;
    skos:narrower :magnesite-nickel-rich ;
    skos:prefLabel "magnesite"@en ;
    schema:citation "https://en.wikipedia.org/wiki/Magnesite"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:magnetite
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "III) oxide"@en ,
        "ferrous-ferric oxide"@en ,
        "iron(II"@en ,
        "lodestone"@en ,
        "magnetic iron ore"@en ,
        "octahedral iron ore"@en ;
    skos:broader :mineral-commodities ;
    skos:definition "A black, cubic, strongly magnetic, opaque mineral of the spinel group with the chemical formula Fe²⁺Fe³⁺₂O₄. It is one of the oxides of iron and with the exception of extremely rare native iron deposits, it is the most magnetic of all the naturally occurring minerals on Earth. Magnetite commonly occurs in octahedrons and also granular or massive; it is a very common and widely distributed accessory mineral in rocks of all kinds (in orebodies as a magmatic segregation, in lenses enclosed in schists and gneisses, in igneous rocks as a primary mineral or as an alteration product, in placer deposits, and as a heavy mineral in sands). Due to its high iron content, magnetite has long been a major iron ore. It is reduced in blast furnaces to pig iron or sponge iron for conversion to steel."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/magnetite> ,
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/magnetiteore> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/magnetite> ,
        <https://linked.data.gov.au/def/geo-commodities/magnetite> ;
    skos:inScheme cs: ;
    skos:narrowMatch
        <http://resource.geosciml.org/classifier/cgi/commodity-code/magnetiteore> ,
        <https://linked.data.gov.au/def/geo-commodities/magnetite-ore> ;
    skos:narrower :magnetite-specimen ;
    skos:prefLabel "magnetite"@en ;
    skos:relatedMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/ironoxide> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/ironoxide> ,
        <https://linked.data.gov.au/def/geo-commodities/iron-oxide> ;
    schema:citation
        "https://en.wikipedia.org/wiki/Magnetite#"^^xsd:anyURI ,
