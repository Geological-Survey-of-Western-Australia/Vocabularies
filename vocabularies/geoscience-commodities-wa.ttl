:opal-gem
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "precious opal"@en ;
    skos:broadMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/gemstone> ,
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/opal> ,
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/silica-gemstone> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/gemstone> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/opal> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/silica-gemstone> ,
