    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:coal-char
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broadMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/coal> ,
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/organicmaterial> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/coal> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/organicmaterial> ,
        <https://linked.data.gov.au/def/geo-commodities/coal> ,
        <https://linked.data.gov.au/def/geo-commodities/organic-material> ;
    skos:broader :coal ;
    skos:definition "An impure carbon residue of the burning of wood or other organic material in the absence of air. It is black, often porous, and able to absorb gases. Like coke, it can be used as a fuel."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "coal - char"@en ;
    schema:citation "https://glossary.americangeosciences.org/term/charcoal-0"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:coal-seam-gas
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "CBM"@en ,
        "CSG"@en ,
        "coal bed methane"@en ,
        "coal seam methane"@en ;
    skos:broadMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/organicmaterial> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/organicmaterial> ,
        <https://linked.data.gov.au/def/geo-commodities/gaseous-hydrocarbons> ,
        <https://linked.data.gov.au/def/geo-commodities/organic-material> ;
    skos:broader :energy-commodities ;
    skos:definition "Coal seam gas (CSG) is a form of natural gas extracted from coal beds. Coal seam gas contains very little heavier hydrocarbons such as propane or butane, and no natural-gas condensate. It often contains up to a few percent carbon dioxide."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/coalbedmethane> ,
