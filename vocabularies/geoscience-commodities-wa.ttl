.

:boron
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broader :mineral-commodities ;
    skos:definition "A chemical element with the symbol B and atomic number 5. Boron is concentrated on Earth by the water-solubility of its more common naturally occurring compounds, the borate minerals. These are mined industrially as evaporites, such as borax and kernite. Most boron extracted from the Earth is refined into boric acid and sodium tetraborate pentahydrate and used as a flux for the production of glass and ceramics, and is also used in agriculture and in detergents."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/boron> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/boron> ,
        <https://linked.data.gov.au/def/geo-commodities/boron> ;
    skos:inScheme cs: ;
    skos:prefLabel "boron"@en ;
    schema:citation
        "http://resource.geosciml.org/classifier/cgi/commodity-code/boron"^^xsd:anyURI ,
        "https://en.wikipedia.org/wiki/Boron#Applications"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:calcite
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "calc spar"@en ,
        "calcareous spar"@en ,
        "spar"@en ;
    skos:broader :mineral-commodities ;
    skos:definition "Calcite is the most stable polymorph of calcium carbonate, a common rock-forming mineral with the chemical formula CaCO₃. Calcite is trigonal, usually white, colourless, or pale shades of grey, yellow and blue. It has perfect rhombohedral cleavage, a vitreous lustre, and a hardness of 3 on the Mohs scale, and readily effervesces in cold dilute hydrochloric acid. Calcite is used for optics (large crystal form) and as a compound additive for soil remediation, soil stabilization and concrete repair."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/calcite> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/calcite> ,
        <https://linked.data.gov.au/def/geo-commodities/calcite> ;
    skos:inScheme cs: ;
