:platinum-group-elements
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "PGE"@en ,
        "PGM"@en ,
        "platidises"@en ,
        "platinides"@en ,
        "platinoids"@en ,
        "platinum family"@en ,
        "platinum group"@en ,
        "platinum group metals"@en ,
        "platinum metals"@en ;
    skos:broader :mineral-commodities ;
    skos:definition "The platinum group elements (PGE) are six metallic elements clustered together in the periodic table. The platinum group elements include platinum, palladium, rhodium, ruthenium, iridium and osmium, which are metals that have similar physical and chemical properties and tend to occur together in nature. PGEs are indispensable to many industrial applications but are mined in only a few places. The PGEs have many useful catalytic properties, are highly resistant to wear and tarnish, making platinum well suited for fine jewellery. Apart from their application in jewellery, platinum metals are also used in anticancer drugs, industries, dentistry, electronics and vehicle exhaust catalysts."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/platinumgroupmetal> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/platinumgroupmetal> ,
        <https://linked.data.gov.au/def/geo-commodities/platinum-group-metal> ;
    skos:inScheme cs: ;
    skos:narrower
        :iridium ,
        :osmium ,
        :palladium ,
        :platinum ,
        :rhenium ,
        :ruthenium ;
    skos:prefLabel "platinum group elements (PGE)"@en ;
    schema:citation
        "https://en.wikipedia.org/wiki/Platinum_group"^^xsd:anyURI ,
        "https://pubs.usgs.gov/publication/pp1802N"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:power-energy
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broader :energy-commodities ;
    skos:definition "Primary sources of energy related to Earth's natural processes that are used to generate electrical energy (power) that can be economically supplied to a market. Electrical energy is energy related to forces on electrically charged particles and the movement of those particles (often electrons in wires, but not always). This energy is supplied by the combination of current and electrical potential (often referred to as voltage because electric potential is measured in volts) that is delivered by a circuit (e.g., provided by an electric power utility). Electrical energy is usually sold by the kilowatt hour (1 kWh = 3.6 MJ), which is the product of the power in kilowatts multiplied by running time in hours. Sources of energy in this category include renewable (solar, nuclear, hydro, wind, geothermal and bioenergy) and nuclear."@en ;
    skos:inScheme cs: ;
    skos:narrower
        :bioenergy ,
        :geothermal-energy ,
        :hydroenergy ,
        :nuclear-energy ,
        :solar-energy ,
        :tidal-energy ,
        :wave-energy ,
        :wind-energy ;
    skos:prefLabel "power (energy)"@en ;
    schema:citation
        "https://en.wikipedia.org/wiki/Electric_power"^^xsd:anyURI ,
        "https://en.wikipedia.org/wiki/Electric_power_industry"^^xsd:anyURI ,
        "https://en.wikipedia.org/wiki/Electrical_energy"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

