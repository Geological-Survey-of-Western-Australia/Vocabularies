.

:europium
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broadMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/rareearthelement> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/rareearthelement> ,
        <https://linked.data.gov.au/def/geo-commodities/rare-earth-element> ;
    skos:broader :rare-earth-elements ;
    skos:definition "Europium is a chemical element with the symbol Eu and atomic number 63. Europium is the most reactive lanthanide by far, having to be stored under an inert fluid to protect it from atmospheric oxygen or moisture. Europium is also the softest lanthanide, as it can be dented with a fingernail and easily cut with a knife. When oxidation is removed a shiny-white metal is visible. Europium has no significant biological role and is relatively non-toxic as compared to other heavy metals. Most applications of europium exploit the phosphorescence of europium compounds. Europium is exempt from classification as either heavy or light as it has two valence states: Eu²⁺ and Eu³⁺."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/europium> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/europium> ,
        <https://linked.data.gov.au/def/geo-commodities/europium> ;
    skos:inScheme cs: ;
    skos:prefLabel "europium"@en ;
    schema:citation "https://en.wikipedia.org/wiki/Europium"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:europium-oxide
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
