:asbestos-anthophyllite
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "anthophyllite asbestos"@en ,
        "grey asbestos"@en ;
    skos:broadMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/asbestos> ,
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/asbestos-amphibole> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/asbestos> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/asbestos-amphibole> ,
        <https://linked.data.gov.au/def/geo-commodities/asbestos> ,
        <https://linked.data.gov.au/def/geo-commodities/asbestos-amphibole> ;
    skos:broader :asbestos-amphibole ;
    skos:definition "A fibrous (asbestiform) form of the orthorhombic, inosilicate amphibole mineral anthophyllite with the chemical formula (Mg,Fe²⁺)₇Si₈O₂(OH)₂. Anthophyllite asbestos was used in asbestos cement, composite flooring, roofing material and for insulation. Lamellar or fibrous anthophyllite is one of the six recognized types of asbestos."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/anthophyllite> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/anthophyllite> ,
