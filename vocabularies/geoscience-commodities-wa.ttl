    skos:inScheme cs: ;
    skos:prefLabel "arsenic"@en ;
    schema:citation "https://en.wikipedia.org/wiki/Arsenic"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

