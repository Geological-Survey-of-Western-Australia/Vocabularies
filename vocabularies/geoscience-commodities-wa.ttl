:pegmatite
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broader :felsic-igneous-rock ;
    skos:definition "An exceptionally coarse-grained igneous rock, with interlocking crystals, usually found as irregular dykes, lenses or veins, especially at the margins of batholiths. Most grains are 1 cm or more in diameter. Pegmatite composition is generally that of granite, although pegmatites having gross compositions similar to other rock types are known; the composition may be simple or complex and may include rare minerals rich in such elements as lithium, boron, fluorine, niobium, tantalum, uranium and rare earths."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "pegmatite"@en ;
    schema:citation "https://glossary.americangeosciences.org/term/pegmatite"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:perlite
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "pearlstone"@en ;
    skos:broader :felsic-igneous-rock ;
    skos:definition "A siliceous volcanic glass with the composition of rhyolite and a perlitic texture, i.e. having numerous concentric spherical cracks that give rise to an onion-skin structure. Most perlite has a higher water content than obsidian. When perlite is heated to the softening point, it expands, or pops to form a light fluffy material similar to pumice. It is used as lightweight aggregate in concrete, as insulation for liquid fuels, and in potting soils."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/perlite> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/perlite> ,
        <https://linked.data.gov.au/def/geo-commodities/perlite> ;
    skos:inScheme cs: ;
    skos:prefLabel "perlite"@en ;
    schema:citation
        "https://en.wikipedia.org/wiki/Perlite"^^xsd:anyURI ,
        "https://glossary.americangeosciences.org/term/perlite"^^xsd:anyURI ,
        "https://www.mindat.org/glossary/perlite"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:petrified-wood
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "fossilised wood"@en ,
        "fossilized wood"@en ;
    skos:broader :mineral-commodities ;
    skos:definition "Fossilized wood with the mineral composition of jasper, chalcedony and, less frequently, opal. It consists of silicon dioxide only. The organic wood is not changed into stone, but only the shape and structural elements of the wood are preserved. It is mostly used for ornamental objects and decorative pieces."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "petrified wood"@en ;
    schema:citation "https://www.gemdat.org/gem-8018.html"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:phenakite
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "phenacite"@en ;
    skos:broader :mineral-commodities ;
    skos:definition "A colourless, white, or pale varicoloured glassy rhombohedral mineral with the chemical formula Be₂SiO₄. It is sometimes confused with quartz. Phenakite is found in high-temperature pegmatite veins and in mica schist associated with quartz, chrysoberyl, apatite and topaz, and is used as gemstone."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/phenakite> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/phenakite> ,
        <https://linked.data.gov.au/def/geo-commodities/phenakite> ;
    skos:inScheme cs: ;
    skos:prefLabel "phenakite"@en ;
    schema:citation
        "https://en.wikipedia.org/wiki/Phenakite"^^xsd:anyURI ,
        "https://glossary.americangeosciences.org/term/phenakite"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:phosphate
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broader :industrial-commodities ;
    skos:definition "The naturally occurring form of the element phosphorus. In mineralogy and geology, phosphate refers to a rock or ore containing phosphate ions. Inorganic phosphates are mined to obtain phosphorus for use in agriculture and industry. The source materials for phosphate are marine phosphorite and, less commonly, guano and apatite-rich igneous rocks."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "phosphate"@en ;
    schema:citation
        "https://en.wikipedia.org/wiki/Phosphate#Geological_occurrence"^^xsd:anyURI ,
        "https://www.mindat.org/glossary/phosphate"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:phosphorus-pentoxide
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "P oxide"@en ,
        "P-oxide"@en ,
        "diphosphorus pentoxide"@en ,
        "phosphoric anhydride"@en ,
        "phosphorus oxide"@en ,
        "phosphorus(V) oxide"@en ,
        "tetraphosphorus decaoxide"@en ,
        "tetraphosphorus decoxide"@en ;
    skos:broader :industrial-commodities ;
    skos:definition "A chemical compound with molecular formula P₄O₁₀ (with its common name derived from its empirical formula, P₂O₅). This white crystalline solid is the anhydride of phosphoric acid. It is a powerful desiccant and dehydrating agent. Phosphorus pentoxide is used in desiccators."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/phosphorouspentoxide> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/phosphorouspentoxide> ,
        <https://linked.data.gov.au/def/geo-commodities/phosphorous-pentoxide> ;
    skos:inScheme cs: ;
    skos:prefLabel "phosphorus pentoxide"@en ;
    schema:citation "https://en.wikipedia.org/wiki/Phosphorus_pentoxide"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:pig-iron
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "crude iron"@en ;
    skos:broader :iron ;
    skos:definition "An intermediate good used by the iron industry in the production of steel, which is developed by smelting iron ore in a blast furnace. Pig iron has a high carbon content, typically 3.8 – 4.7%, along with silica and other constituents of dross, which makes it brittle and not useful directly as a material except for limited applications."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "iron - pig iron"@en ;
    schema:citation "https://en.wikipedia.org/wiki/Pig_iron"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:pilbara-jade
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "Marble Bar jade"@en ;
    skos:broader :mineral-commodities ;
    skos:definition "A predominantly fine-grained, massive green to grey-green chloritic serpentinite. A characteristic feature of Pilbara jade is the occurrence of irregular white patches that may form veins in the massive green chlorite. Pilbara jade occurs specifically in the Pilbara region of Western Australia, and is not a true jade."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Pilbara 'jade'"@en ;
    schema:citation "https://dmpbookshop.eruditetechnologies.com.au/product/gemstones-of-western-australia-second-edition.do"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:pollucite
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broader :mineral-commodities ;
    skos:definition "A zeolite mineral with the formula (Cs,Na)₂Al₂Si₄O₁₂·2H₂O with iron, calcium, rubidium and potassium as common substituting elements. It is a significant ore of cesium and sometimes rubidium. It forms a solid solution series with analcime. It crystallizes in the isometric-hexoctahedral crystal system, and usually occurs as colourless, white, grey, or rarely pink and blue masses; well-formed crystals are rare. It has a Mohs hardness of 6.5 and a specific gravity of 2.9, with a brittle fracture and no cleavage."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "pollucite"@en ;
    schema:citation "https://en.wikipedia.org/wiki/Pollucite"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:potassium
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broader :mineral-commodities ;
    skos:definition "A chemical element with the symbol K and atomic number 19. It is a silvery white metal that is soft enough to easily cut with a knife. Potassium is one of the alkali metals and, in nature, occurs only in ionic salts. It is found dissolved in seawater (which is 0.04% potassium by weight), and occurs in many minerals such as orthoclase, a common constituent of granites and other igneous rocks. Potassium ions are vital for the functioning of all living cells. Most industrial applications of potassium exploit the high solubility of its compounds in water, such as saltwater soap. The major use of potassium is in agricultural fertilizers."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/potassium> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/potassium> ,
        <https://linked.data.gov.au/def/geo-commodities/potassium> ;
    skos:inScheme cs: ;
    skos:prefLabel "potassium"@en ;
    schema:citation "https://en.wikipedia.org/wiki/Potassium"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:potassium-carbonate
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "carbonate of potash"@en ,
        "pearl ash"@en ,
        "salts of tartar"@en ;
    skos:broadMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/potash> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/potash> ,
        <https://linked.data.gov.au/def/geo-commodities/potash> ;
    skos:broader :potash ;
    skos:definition "An inorganic compound with the formula K₂CO₃. It is a white salt, which is soluble in water and forms a strongly alkaline solution. It is deliquescent, often appearing as a damp or wet solid. Potassium carbonate is mainly used in the production of soap and glass. Modern production methods of potassium carbonate include the electrolysis of potassium chloride, which results in potassium hydroxide (KOH); this potassium hydroxide is then carbonated using carbon dioxide to yield potassium carbonate. Other methods involve the reaction of potassium hydroxide with carbon dioxide."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "potash - potassium carbonate (K2CO3)"@en ;
    schema:citation
        "https://en.wikipedia.org/wiki/Potash"^^xsd:anyURI ,
        "https://en.wikipedia.org/wiki/Potassium_carbonate"^^xsd:anyURI ,
        "https://material-properties.org/potassium-carbonate/"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:potassium-chlorate
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "Berthollet salt"@en ,
        "chlorate of potash"@en ,
        "potassium chlorate(V)"@en ,
        "potcrate"@en ;
    skos:broadMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/potash> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/potash> ,
        <https://linked.data.gov.au/def/geo-commodities/potash> ;
    skos:broader :potash ;
    skos:definition "An inorganic compound containing potassium, chlorine and oxygen, with the molecular formula KClO3. In its pure form, it is a white crystalline substance. After sodium chlorate, it is the second most common chlorate in industrial use. It is a strong oxidizing agent and its most important application is in safety matches. In other applications it is mostly obsolete and has been replaced by safer alternatives. It has been used in fireworks, propellants and explosives, to prepare oxygen, both in the lab and in chemical oxygen generators, as a disinfectant, for example in medical mouthwashes, in agriculture as an herbicide."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "potash - potassium chlorate (KClO3)"@en ;
    schema:citation
        "https://en.wikipedia.org/wiki/Potash"^^xsd:anyURI ,
        "https://en.wikipedia.org/wiki/Potassium_chlorate"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:potassium-chloride
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "MOP"@en ,
        "muriate of potash"@en ,
        "potassium salt"@en ,
        "sylvite"@en ;
    skos:broadMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/potash> ,
