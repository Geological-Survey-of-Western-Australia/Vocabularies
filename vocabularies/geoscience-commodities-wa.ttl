        "https://glossary.americangeosciences.org/term/hematite"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:hydrogen
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broader :energy-commodities ;
    skos:definition "A chemical element with the symbol H and atomic number 1. Hydrogen is the lightest element. At standard conditions hydrogen is a gas of diatomic molecules having the formula H₂. It is colourless, odorless, tasteless, non-toxic and highly combustible. The two largest uses are fossil fuel processing (e.g. hydrocracking) and ammonia production. It can be burned to produce heat or combined with oxygen in fuel cells to generate electricity directly, with water being the only emissions at the point of usage."@en ;
    skos:inScheme cs: ;
    skos:narrower
        :hydrogen-manufactured ,
        :hydrogen-natural ;
    skos:prefLabel "hydrogen"@en ;
    schema:citation "https://en.wikipedia.org/wiki/Hydrogen"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:jade
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "jadestone"@en ;
    skos:broadMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/gemstone> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/gemstone> ,
        <https://linked.data.gov.au/def/geo-commodities/gemstone> ;
    skos:broader :mineral-commodities ;
    skos:definition "A hard, extremely tough, compact gemstone consisting of either the pyroxene mineral jadeite or the amphibole variety nephrite, and having an unevenly distributed colour ranging from dark or deep green to dull or greenish white. It takes a high polish, and has long been used for jewellery, carved articles, and various ornamental objects. Note that the term is also often informally applied to various hard green minerals, e.g. 'California jade' (or californite, a green compact variety of vesuvianite), ‘Mexican jade’ (or tuxtlite, and also green-dyed calcite), saussurite, and green varieties of sillimanite, pectolite, garnet and serpentine."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/jade> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/jade> ,
        <https://linked.data.gov.au/def/geo-commodities/jade> ;
    skos:inScheme cs: ;
    skos:narrower
        :jade-black ,
        :jade-nephrite ;
    skos:prefLabel "jade"@en ;
    schema:citation
        "https://en.wikipedia.org/wiki/Jade"^^xsd:anyURI ,
        "https://glossary.americangeosciences.org/term/jade"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:jasper
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "jasperite"@en ,
        "jasperoid"@en ;
    skos:broadMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/gemstone> ,
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/silica-gemstone> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/gemstone> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/silica-gemstone> ,
        <https://linked.data.gov.au/def/geo-commodities/gemstone> ,
        <https://linked.data.gov.au/def/geo-commodities/silica-gemstone> ;
    skos:broader :mineral-commodities ;
    skos:definition "A variety of chert associated with iron ores and containing iron oxide impurities that give it various colours, characteristically red, although yellow, green, greyish-blue, brown and black cherts have also been called jasper. The term has also been applied to any red chert or chalcedony irrespective of associated iron ore."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "jasper"@en ;
    skos:relatedMatch <https://linked.data.gov.au/def/geo-commodities/carnelian> ;
    schema:citation "https://glossary.americangeosciences.org/term/jasper"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:lead
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "Pb"@en ;
    skos:broader :mineral-commodities ;
    skos:definition "A chemical element with the symbol Pb and atomic number 82. It is a heavy metal that is denser than most common materials. Lead is soft and malleable, and also has a relatively low melting point. When freshly cut, lead is a shiny grey with a hint of blue. It tarnishes to a dull grey colour when exposed to air. Lead is toxic, even in small amounts, especially to children. Lead is extensively used in construction, plumbing, batteries, bullets and shot, weights, solders, pewters, fusible alloys, white paints, leaded gasoline and radiation shielding."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/lead> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/lead> ,
        <https://linked.data.gov.au/def/geo-commodities/lead> ;
    skos:inScheme cs: ;
    skos:prefLabel "lead"@en ;
    schema:citation "https://en.wikipedia.org/wiki/Lead"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:lepidolite
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "lithia mica"@en ,
        "lithionite"@en ,
        "lithium mica"@en ;
    skos:broader :mica ;
    skos:definition "A group of trioctahedral Li-rich micas, including polylithionite, trilithionite, taeniolite and zinnwaldite. It commonly occurs in rose or lilac-coloured masses made up of small scales, as in pegmatites."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "lepidolite"@en ;
