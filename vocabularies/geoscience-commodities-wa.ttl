        <https://linked.data.gov.au/def/geo-commodities/potash> ;
    skos:broader :potash ;
    skos:definition "A metal halide salt composed of potassium and chlorine with the chemical formula KCl. It is odorless and has a white or colourless vitreous crystal appearance. The solid dissolves readily in water, and its solutions have a salt-like taste. Potassium chloride can be obtained from ancient dried lake deposits and is used as a fertilizer, in medicine, in scientific applications, as domestic water softeners (as a substitute for sodium chloride salt), and in food processing, where it may be known as E number additive E508. It occurs naturally as the mineral sylvite, and in combination with sodium chloride as sylvinite. Also referred to as muriate of potash (MOP), and commonly used as a fertilizer."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "potash - potassium chloride (MOP, KCl)"@en ;
    schema:citation
        "https://en.wikipedia.org/wiki/Potash"^^xsd:anyURI ,
        "https://en.wikipedia.org/wiki/Potassium_chloride"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:potassium-hydroxide
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "KOH"@en ,
        "caustic potash"@en ,
        "lye"@en ,
