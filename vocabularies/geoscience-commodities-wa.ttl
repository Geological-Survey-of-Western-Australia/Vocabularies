    skos:broader :mineral-commodities ;
    skos:definition "A variously coloured orthorhombic mineral of the baryte group with the chemical formula SrSO₄. It usually occurs in residual clays and in deposits of salt, gypsum, and associated dolomite and shale. Celestine is the principal ore of strontium."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "celestine"@en ;
