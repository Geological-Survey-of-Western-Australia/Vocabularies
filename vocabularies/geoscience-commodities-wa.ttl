:chalcedony
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "calcedony"@en ;
    skos:broadMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/silica-gemstone> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/silica-gemstone> ,
        <https://linked.data.gov.au/def/geo-commodities/silica-gemstone> ;
    skos:broader :mineral-commodities ;
    skos:definition "A cryptocrystalline variety of quartz. It is commonly microscopically fibrous, may be translucent or semitransparent, and has a nearly waxlike lustre, a uniform tint, and a white, pale-blue, grey, brown, or black colour. Chalcedony is the material of much chert, and usually occurs as an aqueous deposit filling or lining cavities in rocks. In the gem trade, the name refers specifically to the light blue-grey or 'common' variety of chalcedony."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/chalcedony> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/chalcedony> ,
