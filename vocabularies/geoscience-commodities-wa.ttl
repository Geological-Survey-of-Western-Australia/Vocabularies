    schema:citation
        "http://en.wikipedia.org/wiki/Coal_bed_methane"^^xsd:anyURI ,
        "http://resource.geosciml.org/classifier/cgi/commodity-code/coal-bed-methane"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:coal-undifferentiated
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broadMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/organicmaterial> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/organicmaterial> ,
        <https://linked.data.gov.au/def/geo-commodities/organic-material> ;
    skos:broader :coal ;
    skos:definition "An organic-rich, sedimentary rock of organic origin, with less than 50% ash (by weight, air dried) or more than 50% organic matter, but otherwise uncategorized; may include legacy projects for which further information is not available."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "coal - undifferentiated"@en ;
    skos:relatedMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/coal> ,
