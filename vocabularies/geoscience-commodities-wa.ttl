    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:saponite
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "bowlingite"@en ,
        "mountain soap"@en ,
        "piotine"@en ,
        "soapstone"@en ;
    skos:broader :mineral-commodities ;
    skos:definition "Saponite is a trioctahedral mineral of the smectite group. Its chemical formula is Ca₀,₂₅(Mg,Fe)₃((Si,Al)₄O₁₀)(OH)₂·n(H₂O). It is soluble in sulfuric acid and has a greasy or soapy feel and appearance. It is soft, massive and plastic, and exists in veins and cavities in serpentinite and basalt."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/saponite> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/saponite> ,
