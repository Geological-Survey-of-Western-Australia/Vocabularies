:thulium
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broadMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/HREE> ,
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/rareearthelement> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/HREE> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/rareearthelement> ,
        <https://linked.data.gov.au/def/geo-commodities/heavy-rare-earth-element> ,
        <https://linked.data.gov.au/def/geo-commodities/rare-earth-element> ;
    skos:broader :heavy-rare-earth-elements ;
    skos:definition "Thulium is a chemical element with the symbol Tm and atomic number 69. It is a rare earth element (REE) the thirteenth and third-last element in the lanthanide series. Thulium is the second-least abundant of the lanthanides, after radioactively unstable promethium which is only found in trace quantities on Earth. It is an easily workable metal with a bright silvery grey lustre. It is fairly soft and slowly tarnishes in air. Despite its high price and rarity, thulium is used as the radiation source in portable X-ray devices, and in some solid-state lasers."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/thulium> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/thulium> ,
        <https://linked.data.gov.au/def/geo-commodities/thulium> ;
    skos:inScheme cs: ;
    skos:prefLabel "thulium"@en ;
    schema:citation "https://en.wikipedia.org/wiki/Thulium"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

