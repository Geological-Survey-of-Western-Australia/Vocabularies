:ammonium
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broader :industrial-commodities ;
    skos:definition "Ammonium is a modified form of ammonia that has an extra hydrogen atom. It is a positively charged (cationic) molecular ion with the chemical formula NH⁺⁴ or [NH4]⁺."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "ammonium"@en ;
    schema:citation "https://en.wikipedia.org/wiki/Ammonium"^^xsd:anyURI ;
