:variscite-industrial
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broadMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/variscite> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/variscite> ,
        <https://linked.data.gov.au/def/geo-commodities/variscite> ;
    skos:broader :industrial-commodities ;
    skos:definition "A pale green, emerald green, bluish-green, or colourless orthorhombic mineral with the chemical formula AlPO₄·2H₂O. Variscite is most commonly used as a gem-quality material to make cabochons and various kinds of carved objects, and often used as a substitute for turquoise. However, it is sometimes used as an aluminium ore, and its phosphorus content can be extracted for use in fertilizers and other chemical products."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "variscite - industrial"@en ;
