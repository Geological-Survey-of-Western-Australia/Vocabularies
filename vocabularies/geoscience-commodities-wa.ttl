:heavy-minerals
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "heavy mineral sands"@en ;
    skos:broader :mineral-commodities ;
    skos:closeMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/heavymineralsand> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/heavymineralsand> ;
    skos:definition "Minerals with a density that is greater than 2.9 g/cm³, including accessory detrital minerals in sediments or sedimentary rocks (e.g. magnetite, ilmenite, zircon, rutile), mafic minerals and resistant minerals that can be concentrated in the panning of alluvium and used as mineralogical and geochemical guides in prospecting. Heavy minerals (with the exception of deposits of heavy mineral sands) usually need to be separated out of their parent material in order to be utilized or studied, generally using a dense liquid in either a separatory funnel or centrifuge."@en ;
    skos:inScheme cs: ;
    skos:narrowMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/mineralsand> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/mineralsand> ,
        <https://linked.data.gov.au/def/geo-commodities/mineral-sand> ;
    skos:prefLabel "heavy minerals"@en ;
    schema:citation
        "https://en.wikipedia.org/wiki/Heavy_mineral"^^xsd:anyURI ,
        "https://glossary.americangeosciences.org/term/heavymineralsed"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:helium
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broader :energy-commodities ;
    skos:definition "An inert, monatomic, colourless, odorless element with the symbol He, the lightest of the rare gases. Except for hydrogen, helium is the most abundant element found in the universe. Although strictly speaking not an energy commodity, the bulk of the world's supply is currently extracted as a byproduct from natural gas and in the future helium will likely be increasingly sourced as a byproduct of natural hydrogen wells — hence the inclusion in this category. Helium is widely used in cryogenic research and is vital in the study of superconductivity. Helium is used for arc welding, as a cooling medium for nuclear reactors, and as a gas for supersonic wind tunnels; extensively used for filling balloons as it is much safer than hydrogen. One of the recent largest uses for helium has been for pressuring liquid fuel rockets."@en ;
    skos:exactMatch <https://linked.data.gov.au/def/geo-commodities/helium> ;
    skos:inScheme cs: ;
    skos:prefLabel "helium"@en ;
    schema:citation "https://www.mindat.org/glossary/helium"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

