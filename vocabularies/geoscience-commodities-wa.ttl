.

:chromite
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "chrome iron ore"@en ;
    skos:broader :mineral-commodities ;
    skos:definition "A brownish-black to iron-black cubic mineral of the spinel group with the chemical formula Fe²⁺Cr₂O₄. It occurs in octahedral crystals as a primary accessory mineral in basic and ultrabasic igneous rocks. Chromite is isomorphous with magnesiochromite and is the most important ore of chromium. Chromite is used as a refractory material, because it has a high heat stability."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/chromite> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/chromite> ,
        <https://linked.data.gov.au/def/geo-commodities/chromite> ;
    skos:inScheme cs: ;
    skos:prefLabel "chromite"@en ;
