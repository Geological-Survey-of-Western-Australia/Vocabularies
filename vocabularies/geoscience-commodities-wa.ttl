:lignite
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "brown coal"@en ,
        "coal - brown"@en ,
        "fulvurite"@en ,
        "sub-bituminous coal"@en ,
        "subbituminous coal"@en ;
    skos:broadMatch <https://linked.data.gov.au/def/geo-commodities/coal> ;
    skos:broader :coal ;
    skos:definition "Lignite, often referred to as sub-bituminous or brown coal, is a soft brownish-black combustible sedimentary rock that is formed from naturally compressed peat. Lignite has visible plant fragments set in a finer grained matrix, with 60–75% carbon content dry ash free and 46-63% volatiles. It is considered the lowest rank of coal due to its relatively low heat content."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/browncoal> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/browncoal> ,
        <https://linked.data.gov.au/def/geo-commodities/brown-coal> ;
    skos:inScheme cs: ;
    skos:prefLabel "lignite"@en ;
    schema:citation
        "http://en.wikipedia.org/wiki/Brown_coal"^^xsd:anyURI ,
        "http://resource.geosciml.org/classifier/cgi/commodity-code/brown-coal"^^xsd:anyURI ,
