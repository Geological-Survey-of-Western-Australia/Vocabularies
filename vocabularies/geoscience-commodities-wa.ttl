:cement
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broader :industrial-commodities ;
    skos:definition "A manufactured grey powder that, when mixed with water, will set, harden and adhere to other materials to bind them together. Cement mixed with fine aggregate produces mortar for masonry, or with sand and gravel, produces concrete."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "cement"@en ;
