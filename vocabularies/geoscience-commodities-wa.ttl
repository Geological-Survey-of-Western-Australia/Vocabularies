:cryolite
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "Greenland spar"@en ,
        "ice stone"@en ;
    skos:broader :mineral-commodities ;
    skos:definition "A variously coloured monoclinic mineral with the chemical formula Na₃AlF₆. It may contain iron and has been found chiefly in a pegmatite at Ivigtut, Greenland, in cleavable masses of waxy lustre. Natural and synthetic cryolite is used in the manufacture of aluminium as a flux to dissolve aluminium from oxide minerals."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/cryolite> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/cryolite> ,
