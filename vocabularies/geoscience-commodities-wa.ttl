    skos:inScheme cs: ;
    skos:narrowMatch <https://linked.data.gov.au/def/geo-commodities/ceramic-sand> ;
    skos:narrower :silica-flour ;
    skos:prefLabel "silica sand"@en ;
    schema:citation "https://www.mindat.org/glossary/silica_sand"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:slate
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broader :industrial-commodities ;
    skos:definition "An ultrafine- or very fine-grained rock displaying strong slaty cleavage and hence can be split into slabs and thin plates. Most slate formed from shale during low grade regional metamorphism. Usually grey to black, sometimes green, yellow, brown or red. Slates are composed mostly of quartz, micas and chlorite, with minor hematite, clays and other minerals. Slate is used in roofing, interior and exterior flooring, and other roles as a building material."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/slate> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/slate> ,
