:clay-ball
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "ball clay"@en ;
    skos:broader :clay ;
    skos:definition "Ball clays are kaolinitic sedimentary clays that typically contain 20–80% kaolinite, 10–25% mica and 6–65% quartz, along with small amounts of organic matter like lignite and trace minerals such as pyrite and siderite. They are widely used in ceramics to provide unfired strength, plasticity and rheological stability during shaping processes. When fired in an oxidising atmosphere, most ball clays produce colours ranging from buff to cream to off-white."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "clay - ball"@en ;
    schema:citation "https://en.wikipedia.org/wiki/Ball_clay"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

