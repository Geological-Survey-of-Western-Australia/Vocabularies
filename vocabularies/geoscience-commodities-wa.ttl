:asbestos-crocidolite-riebeckite
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "blue asbestos"@en ,
        "fibrous riebeckite"@en ;
    skos:broadMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/asbestos> ,
