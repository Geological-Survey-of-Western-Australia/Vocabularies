.

:andalusite
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "aluminosilicate"@en ,
        "aluminosilicate polymorph"@en ;
    skos:broadMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/aluminosilicate> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/aluminosilicate> ,
        <https://linked.data.gov.au/def/geo-commodities/aluminosilicate> ;
    skos:broader :mineral-commodities ;
    skos:definition "A brown, yellow, green, red, or grey orthorhombic nesosilicate mineral with the chemical formula Al₂SiO₅. It is trimorphous with kyanite and sillimanite. Andalusite occurs as thick, nearly square prisms in regionally metamorphosed aluminous rocks at medium temperatures and pressures, and is characteristic of contact-metamorphosed argillaceous rocks. Andalusite has several industrial and commercial uses, mainly in the refractory, ceramic/porcelain, foundry and glass industries and other specialized applications."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/andalusite> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/andalusite> ,
        <https://linked.data.gov.au/def/geo-commodities/andalusite> ;
    skos:inScheme cs: ;
    skos:narrower :chiastolite ;
    skos:prefLabel "andalusite"@en ;
