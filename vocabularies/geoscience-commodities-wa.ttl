    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:potassium-permanganate
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "Condy's crystals"@en ,
        "chameleon mineral"@en ,
        "hypermangan"@en ,
        "permanganate of potash"@en ,
        "potassium manganate(VII)"@en ,
        "purple potion powder"@en ;
    skos:broadMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/potash> ,
