:niobium-pentoxide
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "Nb oxide"@en ,
        "Nb-oxide"@en ,
        "Niobium(V) oxide"@en ;
    skos:broadMatch
