.

:wind-energy
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broadMatch <https://linked.data.gov.au/def/geo-commodities/energy-resources> ;
    skos:broader :power-energy ;
    skos:definition "The use of wind energy to generate electricity. Wind turbines use the wind energy to spin an electric generator and are generally grouped into wind farms and connected to the electrical grid. Wind energy is considered a sustainable, renewable energy source, and has a much smaller impact on the environment compared to burning fossil fuels."@en ;
    skos:exactMatch <https://linked.data.gov.au/def/geo-commodities/wind-power> ;
