    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:samarium
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broadMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/LREE> ,
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/rareearthelement> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/LREE> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/rareearthelement> ,
        <https://linked.data.gov.au/def/geo-commodities/light-rare-earth-elements> ,
        <https://linked.data.gov.au/def/geo-commodities/rare-earth-element> ;
    skos:broader :heavy-rare-earth-elements ;
    skos:definition "Samarium is a chemical element with symbol Sm and atomic number 62. It is a rare earth element (REE) and a moderately hard, silvery metal that slowly oxidizes in air. The main commercial use of samarium is in samarium–cobalt magnets, which have permanent magnetization."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/samarium> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/samarium> ,
