    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:scandium
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broader :light-rare-earth-elements ;
    skos:definition "Scandium is a chemical element with the symbol Sc and atomic number 21. It is a silvery white metallic rare earth element (REE). Scandium is present in most of the deposits of rare earth and uranium compounds, but it is extracted from these ores in only a few mines worldwide. Scandium is mainly used in aluminium alloys."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/scandium> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/scandium> ,
        <https://linked.data.gov.au/def/geo-commodities/scandium> ;
    skos:inScheme cs: ;
    skos:prefLabel "scandium"@en ;
    schema:citation "https://en.wikipedia.org/wiki/Scandium"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:scandium-oxide
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "scandia"@en ,
        "scandium(III) oxide"@en ;
    skos:broader :rare-earth-oxides ;
    skos:definition "Scandium oxide is an inorganic compound with the chemical formula Sc₂O₃. It is one of several oxides of rare earth elements with a high melting point. It is used in the preparation of other scandium compounds as well as in high-temperature systems (for its resistance to heat and thermal shock), electronic ceramics, and glass composition (as a helper material)."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "scandium oxide"@en ;
    schema:citation "https://en.wikipedia.org/wiki/Scandium_oxide"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:sea-shells-shell-grit
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "sea shells"@en ;
    skos:broadMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/lime> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/lime> ,
        <https://linked.data.gov.au/def/geo-commodities/lime> ;
    skos:broader :limesand ;
    skos:definition "Shell grit is coarsely ground or broken seashells. It is used, among other things, in the poultry industry as a poultry feed calcium supplement (e.g. to aid bird digestion). Also used as a soil additive in landscaping and as a cleaning agent in aquaculture."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/shellgrit> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/shellgrit> ,
