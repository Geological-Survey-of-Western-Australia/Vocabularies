:clay-industrial
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "industrial clay"@en ;
    skos:broadMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/clay> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/clay> ,
        <https://linked.data.gov.au/def/geo-commodities/clay> ;
    skos:broader :clay ;
    skos:definition "A concept referring to clay that may be processed to generate industrial materials such as lightweight expanded clay aggregate (LECA, also known as expanded clay or exclay), i.e. a lightweight aggregate made by heating clay to around 1200 °C in a rotary kiln. The heating process causes gases trapped in the clay to expand, forming thousands of small bubbles and giving the material a porous structure; the process is used to generate lightweight concrete products for construction and for use in hydroponics/aquaponics."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "clay - industrial"@en ;
    schema:citation
        "https://en.wikipedia.org/wiki/Expanded_clay_aggregate"^^xsd:anyURI ,
