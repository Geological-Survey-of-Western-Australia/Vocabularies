:alunite
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "K-Alunite"@en ,
        "alum"@en ,
        "alum rock"@en ,
        "aluminilite"@en ,
        "alumite"@en ,
        "alumstone"@en ,
        "calafatite"@en ,
        "ignatiewite"@en ,
        "kalioalunite"@en ;
    skos:broader :mineral-commodities ;
    skos:definition "A vitreous, white or pale-coloured rhombohedral mineral with the chemical formula of KAl₃(SO₄)₂(OH)₆. It is isomorphous with natroalunite, sometimes contains appreciable sodium, generally occurs as a hydrothermal alteration product in feldspathic igneous rocks. Alunite is used in the manufacture of alum (aluminium sulfate, Al₂(SO₄)3·nH₂O, commonly used for most industrial flocculation)."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/alunite> ,
