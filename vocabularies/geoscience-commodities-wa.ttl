:talc
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "soaprock"@en ,
        "soapstone"@en ,
        "steatite"@en ;
    skos:broader :industrial-commodities ;
    skos:definition "An extremely soft, light green or grey monoclinic mineral with the chemical formula Mg₃Si₄O₁₀(OH)₂. It has a characteristic soapy or greasy feel and a hardness of 1 on the Mohs scale, and it is easily cut with a knife. Talc is a common secondary mineral derived by alteration (hydration) of non-aluminous magnesium silicates (such as olivine, enstatite, and tremolite) in basic igneous rocks, or by metamorphism of dolomite rocks, and it usually occurs in foliated, granular or fibrous masses. Talc is used as a filler, coating, and dusting agent, as a flux in ceramics, and in rubber, plastics, lubricants and talcum powder. In a commercial sense, talc refers more broadly to a talc-rich (talcose) rock, i.e. a rock consisting of talc, tremolite, chlorite, anthophyllite, and related minerals that commonly alter to talc that can be used as a dimension stone or for lapidary purposes."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/talc> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/talc> ,
        <https://linked.data.gov.au/def/geo-commodities/talc> ;
    skos:inScheme cs: ;
    skos:prefLabel "talc"@en ;
    schema:citation
        "https://en.wikipedia.org/wiki/Talc"^^xsd:anyURI ,
        "https://glossary.americangeosciences.org/term/talc"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:tiger-eye
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "pseudocrocidolite"@en ,
        "tiger eye"@en ,
        "tiger's eye"@en ,
        "tiger's-eye"@en ,
        "tiger-eye"@en ,
