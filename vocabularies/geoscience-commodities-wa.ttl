    schema:citation "https://en.wikipedia.org/wiki/Copper"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:diamond
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broader :mineral-commodities ;
    skos:definition "Diamond is a solid form of the element carbon with its atoms arranged in a crystal structure called diamond cubic. Diamonds form under extreme temperatures and pressures and are found in ultrabasic breccias, pipes in igneous rocks, and alluvial deposits. Pure diamond is colourless or nearly so, colour is imparted by impurities. When transparent and more or less free from flaws, it is the most cherished and among the most highly valued gemstones. Diamond has the highest hardness and thermal conductivity of any natural material, properties that are used in major industrial applications such as cutting and polishing tools."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/diamond> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/diamond> ,
        <https://linked.data.gov.au/def/geo-commodities/diamond> ;
    skos:inScheme cs: ;
