:potassium-nitrate
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "nitrate of potash"@en ,
        "potash"@en ,
        "saltpeter"@en ;
    skos:broadMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/potash> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/potash> ,
        <https://linked.data.gov.au/def/geo-commodities/potash> ;
    skos:broader :potash ;
    skos:definition "A chemical compound with a sharp, salty, bitter taste and with the chemical formula KNO₃. Potassium nitrate is a white to dirty grey crystalline solid that is water soluble and noncombustible but accelerates the burning of combustible materials. Major uses of potassium nitrate are in fertilizers, tree stump removal, rocket propellants and fireworks. It is one of the major constituents of gunpowder. In processed meats, potassium nitrate reacts with hemoglobin and myoglobin generating a red colour."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "potash - potassium nitrate (KNO3)"@en ;
    schema:citation "https://en.wikipedia.org/wiki/Potassium_nitrate"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:prehnite
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broader :mineral-commodities ;
    skos:definition "A pale green, yellow brown, or white orthorhombic mineral with the chemical formula Ca₂Al₂Si₃O₁₀(OH)₂. It usually occurs in crystalline aggregates with a botryoidal or mammillary and radiating structure, and is commonly associated with zeolites in geodes, druses, fissures, or joints in altered igneous rocks. It is an indicator mineral of the prehnite–pumpellyite metamorphic facies and used as a gemstone."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/prehnite> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/prehnite> ,
