:alumina-fused
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "aloxide"@en ,
        "aloxite"@en ,
        "aluminium oxide"@en ,
        "alundum"@en ,
        "white fused alumina"@en ;
    skos:broadMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/alumina> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/alumina> ,
        <https://linked.data.gov.au/def/geo-commodities/alumina> ;
    skos:broader :alumina ;
    skos:definition "Aluminium oxide manufactured by the smelting of calcined bauxite and alumina in electric arc furnaces by electrothermal fusion at temperatures of around 2000 °C. Fused alumina has a value of 9 on the Mohs scale of hardness as well as sharp-edged grains, great load bearing capacity, a high degree of shock resistance and thermal and chemical stability. Fused aluminas are used as abrasives, refractories and for sandblasting."@en ;
    skos:historyNote "Defintion from Imerys Group's website." ;
    skos:inScheme cs: ;
    skos:prefLabel "alumina - fused"@en ;
    schema:citation "https://www.imerys.com/minerals/fused-alumina"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:aluminium
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broader :mineral-commodities ;
    skos:definition "A chemical element in the boron group with symbol Al and atomic number 13. It is a silvery white, soft ductile metal. Aluminium is the third most abundant element (after oxygen and silicon), and the most abundant metal in the Earth's crust. It makes up about 8% by weight of the Earth's solid surface. Aluminium metal is so chemically reactive that native specimens are rare and limited to extreme reducing environments. Instead, it is found combined in over 270 different minerals. The chief ore of aluminium is bauxite."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/aluminium> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/aluminium> ,
