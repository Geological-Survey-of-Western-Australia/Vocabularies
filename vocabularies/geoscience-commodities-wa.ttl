        <https://linked.data.gov.au/def/geo-commodities/rare-earth-element> ;
    skos:broader :heavy-rare-earth-elements ;
    skos:definition "Ytterbium is a chemical element with the symbol Yb and atomic number 70. It is a rare earth element (REE), the fourteenth and penultimate element in the lanthanide series. Like the other lanthanides, its most common oxidation state is +3, as in its oxide, halides and other compounds. Commercially recovered from monazite sand. Has a possible use in improving the mechanical properties of stainless steel; few other uses have been found."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/ytterbium> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/ytterbium> ,
        <https://linked.data.gov.au/def/geo-commodities/ytterbium> ;
    skos:inScheme cs: ;
    skos:prefLabel "ytterbium"@en ;
    schema:citation
