    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:spongolite
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "spiculite"@en ;
    skos:broader :industrial-commodities ;
    skos:definition "A light and porous sediment or rock composed principally of the remains of sponge and sponge spicules, and with porosity greater than 50%. As a natural mineral product, spongolite has a very broad use due to its fast absorbancy rate and compatibility with fluid product, and is used as an absorbant for fluid spills (including chemicals, acids and oil). Being heat resistant, spongolite can be used as a safety and fire prevention tool; it can assist in reducing odour and is used in the preparation of potting mixes."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/spongolite> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/spongolite> ,
        <https://linked.data.gov.au/def/geo-commodities/spongolite> ;
    skos:historyNote "Uses compiled from www.spongolite.com.au." ;
    skos:inScheme cs: ;
    skos:prefLabel "spongolite"@en ;
    schema:citation
