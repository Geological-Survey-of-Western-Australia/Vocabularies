        <https://linked.data.gov.au/def/geo-commodities/opal> ,
        <https://linked.data.gov.au/def/geo-commodities/silica-gemstone> ;
    skos:broader :opal ;
    skos:definition "A variety of opal that displays iridescence. Precious gem-quality opal shows a variable interplay of internal colours, and though it is a mineraloid, it has an internal structure. For gemstone use, most opal is cut and polished to form a cabochon. The term 'natural opal' refers to polished stones consisting wholly of precious gem-quality opal."@en ;
    skos:inScheme cs: ;
    skos:narrowMatch
        <https://linked.data.gov.au/def/geo-commodities/black-opal> ,
        <https://linked.data.gov.au/def/geo-commodities/boulder-opal> ,
        <https://linked.data.gov.au/def/geo-commodities/matrix-opal> ,
        <https://linked.data.gov.au/def/geo-commodities/white-opal> ;
    skos:narrower :opal-fire ;
    skos:prefLabel "opal - gem"@en ;
    schema:citation "https://en.wikipedia.org/wiki/Opal"^^xsd:anyURI ;
