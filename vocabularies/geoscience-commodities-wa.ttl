:sepiolite
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "meerschaum"@en ,
        "sea-foam"@en ;
    skos:broader :mineral-commodities ;
    skos:definition "An orthorhombic chain-structure clay mineral with the chemical formula Mg₄Si₆O₁₅(OH)₂·6H₂O. It is a white to light grey or light yellow material, extremely lightweight, absorbent, and compact. Sepiolite is used for making tobacco pipes, cigar and cigarette holders, and ornamental carvings. Sepiolite occurs in veins with calcite, and in alluvial deposits formed from weathering of serpentine masses."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/sepiolite> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/sepiolite> ,
