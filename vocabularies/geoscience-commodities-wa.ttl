    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:antimony
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broader :mineral-commodities ;
    skos:definition "A native metallic element with symbol Sb and atomic number 51. A lustrous grey metalloid, it is found in nature mainly as the sulfide mineral stibnite (Sb₂S₃). Antimony is an extremely brittle metal with a flaky, crystalline texture and commonly occurs in silvery or tin-white granular, lamellar or shapeless masses. Antimony is used in semiconductors, batteries, antifriction alloys, type metal, small arms, tracer bullets, cable sheathing, flame-proofing compounds, paints, ceramics, glass, and pottery. Antimony and many of its products are toxic."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/antimony> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/antimony> ,
