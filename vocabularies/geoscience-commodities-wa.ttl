.

:asbestos-chrysotile-serpentine
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "chrysotile asbestos"@en ,
        "white asbestos"@en ;
    skos:broadMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/asbestos> ,
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/asbestos-serpentine> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/asbestos> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/asbestos-serpentine> ,
        <https://linked.data.gov.au/def/geo-commodities/asbestos> ,
        <https://linked.data.gov.au/def/geo-commodities/asbestos-serpentine> ;
    skos:broader :asbestos-serpentine ;
    skos:definition "A monoclinic or orthorhombic fibrous asbestiform mineral of the serpentine subgroup with the formula Mg₃(Si₂O₅)(OH)₄, commonly known as 'white asbestos'. Due to its fibrous form, chrysotile can be spun and woven into fabric, and was used in asbestos cement roof sheets, ceiling panels and for walls and floors. Chrysotile has been a component in some plasters, brake linings, fire barriers, pipe insulation, and gaskets for high temperature equipment. Chrysotile is the only asbestos mineral in the serpentine subgroup."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/chrysotile> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/chrysotile> ,
