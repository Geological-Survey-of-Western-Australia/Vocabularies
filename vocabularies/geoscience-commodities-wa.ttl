:neodymium
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broadMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/LREE> ,
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/rareearthelement> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/LREE> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/rareearthelement> ,
        <https://linked.data.gov.au/def/geo-commodities/light-rare-earth-elements> ,
        <https://linked.data.gov.au/def/geo-commodities/rare-earth-element> ;
    skos:broader :light-rare-earth-elements ;
    skos:definition "Neodymium is a chemical element with the symbol Nd and atomic number 60. It is the fourth member of the lanthanide series and is considered to be one of the rare earth elements (REE). It is a hard, slightly malleable, silvery metal that quickly tarnishes in air and moisture. Neodymium is not found naturally in metallic form or unmixed with other lanthanides, and it is usually refined for general use. Neodymium is fairly common — about as common as cobalt, nickel, or copper — and is widely distributed in the Earth's crust. Applications of neodymium include use in magnets, glass, lasers and to make contrast agents for transmission electron microscopy."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/neodymium> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/neodymium> ,
        <https://linked.data.gov.au/def/geo-commodities/neodymium> ;
    skos:inScheme cs: ;
    skos:prefLabel "neodymium"@en ;
    schema:citation "https://en.wikipedia.org/wiki/Neodymium"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:neodymium-oxide
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "Nd oxide"@en ,
        "Nd(III) oxide"@en ,
        "Nd(III)-oxide"@en ,
