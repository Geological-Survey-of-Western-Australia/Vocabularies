:gadolinium
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broadMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/HREE> ,
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/rareearthelement> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/HREE> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/rareearthelement> ,
        <https://linked.data.gov.au/def/geo-commodities/heavy-rare-earth-element> ,
        <https://linked.data.gov.au/def/geo-commodities/rare-earth-element> ;
    skos:broader :heavy-rare-earth-elements ;
    skos:definition "Gadolinium is a chemical element with the symbol Gd and atomic number 64. Gadolinium is a silvery-white metal when oxidation is removed. It is only slightly malleable and is a ductile rare earth element (REE). Gadolinium reacts with atmospheric oxygen or moisture slowly to form a black coating. It is found in nature only in an oxidized form. Gadolinium has a variety of specialized uses including as a neutron absorber, additive to alloys, magnetic contrast agent, medical imaging, electrolyte in fuel cells, in superconductors and in a variety of electronic and optical devices."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/gadolinium> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/gadolinium> ,
        <https://linked.data.gov.au/def/geo-commodities/gadolinium> ;
    skos:inScheme cs: ;
    skos:prefLabel "gadolinium"@en ;
    schema:citation "https://en.wikipedia.org/wiki/Gadolinium"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

