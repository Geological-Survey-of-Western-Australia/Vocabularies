    skos:inScheme cs: ;
    skos:prefLabel "uranium"@en ;
    schema:citation
        "https://en.wikipedia.org/wiki/Uranium"^^xsd:anyURI ,
        "https://linked.data.gov.au/def/geo-commodities/uranium"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:vanadium-pentoxide
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "Va(V) oxide"@en ,
        "Va(V)-oxide"@en ,
        "divanadium pentoxide"@en ,
        "vanadia"@en ,
        "vanadic anhydride"@en ,
        "vanadium(V) oxide"@en ,
        "vanadium(V)-oxide"@en ;
    skos:broader :mineral-commodities ;
    skos:definition "Vanadium pentoxide is the inorganic compound with the formula V₂O₅. It is a brown/yellow solid, although when freshly precipitated from aqueous solution, its colour is deep orange. Because of its high oxidation state, it is both an amphoteric oxide and an oxidizing agent. From an industrial perspective, it is the most important compound of vanadium, being the principal precursor to alloys of vanadium and is a widely used industrial catalyst."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/vanadiumpentoxide> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/vanadiumpentoxide> ,
        <https://linked.data.gov.au/def/geo-commodities/vanadium-pentoxide> ;
    skos:inScheme cs: ;
    skos:prefLabel "vanadium pentoxide"@en ;
    schema:citation "https://en.wikipedia.org/wiki/Vanadium(V)_oxide"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:zoisite
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broader :mineral-commodities ;
    skos:definition "A variously coloured orthorhombic mineral related to epidote, with the chemical formula Ca₂Al₃(SiO₄)(Si₂O₇)O(OH). It usually contains appreciable ferric iron, and is white, grey, brown, green, or rose red in colour. Zoisite occurs in metamorphic rocks and in altered igneous rocks, and is an essential constituent of saussurite."@en ;
    skos:inScheme cs: ;
    skos:narrower :thulite ;
    skos:prefLabel "zoisite"@en ;
