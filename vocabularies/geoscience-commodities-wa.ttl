    skos:broadMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/potash> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/potash> ,
        <https://linked.data.gov.au/def/geo-commodities/potash> ;
    skos:broader :potash ;
    skos:definition "Potassium hydroxide is an inorganic compound with the formula KOH and is commonly called caustic potash. Along with sodium hydroxide (NaOH), KOH is a prototypical strong base. It has many industrial and niche applications, most of which exploit its caustic nature and its reactivity toward acids. An estimated 700 000 to 800 000 tonnes were produced in 2005. KOH is noteworthy as the precursor to most soft and liquid soaps, as well as numerous potassium-containing chemicals. It is a white solid that is dangerously corrosive."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "potash - potassium hydroxide (KOH)"@en ;
    schema:citation
        "https://en.wikipedia.org/wiki/Potash"^^xsd:anyURI ,
