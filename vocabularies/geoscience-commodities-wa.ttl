    skos:inScheme cs: ;
    skos:prefLabel "samarium"@en ;
    schema:citation "https://en.wikipedia.org/wiki/Samarium"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:samarium-oxide
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "samaria"@en ,
        "samarium sesquioxide"@en ,
        "samarium(III) oxide"@en ;
    skos:broadMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/lightrareearthoxide> ,
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/rareearthoxide> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/lightrareearthoxide> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/rareearthoxide> ,
        <https://linked.data.gov.au/def/geo-commodities/light-rare-earth-oxide> ,
        <https://linked.data.gov.au/def/geo-commodities/rare-earth-oxide> ;
    skos:broader :rare-earth-oxides ;
    skos:definition "Samarium oxide is a compound with the chemical formula Sm₂O₃. Samarium oxide readily forms on the surface of samarium metal under humid conditions or temperatures in excess of 150 °C in dry air. The oxide is commonly white to off yellow in colour and is often encountered as a highly fine dust like powder. Samarium oxide is used in optical and infrared absorbing glass to absorb infrared radiation. It is also used as a neutron absorber in control rods for nuclear power reactors, as a catalyst for the dehydration and dehydrogenation of primary and secondary alcohols and for preparation of other samarium salts."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "samarium oxide"@en ;
    schema:citation "https://en.wikipedia.org/wiki/Samarium(III)_oxide"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:sand-foundry
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "foundry sand"@en ,
        "molding sand"@en ,
        "moulding sand"@en ;
    skos:broadMatch <https://linked.data.gov.au/def/geo-commodities/sand> ;
    skos:broader :sand-construction ;
    skos:definition "Clean, uniformly sized, high-quality silica sand, used in foundry casting processes. Foundry sand is bonded to form molds or patterns used for ferrous (iron and steel) and non-ferrous (copper, aluminium, brass) metal castings."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/foundrysand> ,
