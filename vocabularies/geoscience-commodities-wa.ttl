:zirconia-fused
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "fused zirconium dioxide"@en ,
        "fused zirconium oxide"@en ;
    skos:broadMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/zirconia> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/zirconia> ,
        <https://linked.data.gov.au/def/geo-commodities/zirconia> ;
    skos:broader :zirconium-oxide ;
    skos:definition "Fused zirconia (zirconium oxide; ZrO₂) is produced through the reduction and fusion of zircon sand (zirconium silicate). Zircon is mixed with coke and heated to its fusion point (in excess of 2800 °C) in an electric arc furnace where it dissociates to zirconium oxide and fumed silica. Fused zirconia is used in structural ceramics, refractories and pigments."@en ;
    skos:historyNote "Definitions compiled from the Zircon Association and Zircomet's websites." ;
    skos:inScheme cs: ;
    skos:prefLabel "zirconia - fused"@en ;
    schema:citation
        "http://en.wikipedia.org/wiki/Zirconia"^^xsd:anyURI ,
        "http://www.zircomet.com/det/10948/Fused-Zirconium-Oxide/"^^xsd:anyURI ,
        "https://www.zircon-association.org/zirconia"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:zirconium-oxide
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "zirconia"@en ,
        "zirconium dioxide"@en ,
        "zirconium(IV) oxide"@en ;
    skos:broader :mineral-commodities ;
    skos:definition "Zirconium oxide (ZrO₂) (not to be confused with zircon) is a white crystalline oxide of zirconium. Its most naturally occurring form, with a monoclinic crystalline structure, is the mineral baddeleyite. A dopant stabilized cubic structured zirconia, cubic zirconia, is synthesized in various colours for use as a gemstone and a diamond simulant."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/zirconia> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/zirconia> ,
        <https://linked.data.gov.au/def/geo-commodities/zirconia> ;
    skos:inScheme cs: ;
