:clay-fireclay
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "fireclay"@en ;
    skos:broadMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/clay> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/clay> ,
        <https://linked.data.gov.au/def/geo-commodities/clay> ;
    skos:broader :clay ;
    skos:definition "A siliceous refractory clay rich in hydrous aluminium silicates. The term fireclay refers to a range of refractory clays used in the manufacture of ceramics, especially fire brick. The United States Environmental Protection Agency defines fire clay very generally as a 'mineral aggregate composed of hydrous silicates of aluminium (Al₂O₃·2SiO₂·2H₂O) with or without free silica'."@en ;
    skos:exactMatch <https://linked.data.gov.au/def/geo-commodities/fire-clay> ;
    skos:inScheme cs: ;
    skos:prefLabel "clay - fireclay"@en ;
    schema:citation "https://glossary.americangeosciences.org/term/fireclay"^^xsd:anyURI ;
