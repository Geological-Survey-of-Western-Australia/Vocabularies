        "https://glossary.americangeosciences.org/term/andalusite"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:asbestos
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "amianthus"@en ,
        "asbestus"@en ,
        "earth flax"@en ,
        "mountain flax"@en ;
    skos:broader :mineral-commodities ;
    skos:definition "A class of silicate minerals with a highly fibrous (asbestiform) structure, which are heat resistant and chemically inert. Asbestos minerals possess high electrical insulating qualities and are of sufficient flexibility to be woven. The two main groups of asbestos minerals are in the serpentine and amphibole groups. A fibrous amphibole may be for example crocidolite, a fibrous variety of riebeckite (a sodic amphibole). Many other amphiboles can be asbestiform, forming respirable (and usually carcinogenic) fibres when crushed, including tremolite, anthophyllite, actinolite, richterite, winchite and fluoro-edenite. Commercially, asbestos was a term used for three industrial materials: chrysotile, amosite and crocidolite. It is also used for the asbestos-containing product, e.g. “asbestos sheet” is cement sheeting usually containing less than 15% asbestos minerals. Asbestos is no longer mined, used or imported in Australia."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/asbestos> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/asbestos> ,
        <https://linked.data.gov.au/def/geo-commodities/asbestos> ;
    skos:inScheme cs: ;
    skos:narrowMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/anthophyllite> ,
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/asbestos-amphibole> ,
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/asbestos-serpentine> ,
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/chrysotile> ,
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/crocidolite> ,
