        <https://linked.data.gov.au/def/geo-commodities/rare-earth-element> ;
    skos:broader :heavy-rare-earth-elements ;
    skos:definition "Lutetium is a chemical element with the symbol Lu and atomic number 71. It is a silvery white metal, which resists corrosion in dry air, but not in moist air. Lutetium is the last element in the lanthanide series, and it is traditionally counted among the rare earth elements (REE). Lutetium usually occurs in association with the element yttrium and is sometimes used in metal alloys and as a catalyst in various chemical reactions."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/lutetium> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/lutetium> ,
        <https://linked.data.gov.au/def/geo-commodities/lutetium> ;
    skos:inScheme cs: ;
    skos:prefLabel "lutetium"@en ;
    schema:citation "https://en.wikipedia.org/wiki/Lutetium"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

