    rdfs:isDefinedBy cs: ;
    skos:broader :industrial-commodities ;
    skos:definition "A widely used term describing dark-coloured igneous rocks that contain ≥30% ferromagnesian rock-forming silicates (often referred to as mafic minerals; including pyroxene, amphibole, olivine and biotite). Usually applied to basaltic, doleritic and gabbroic rocks."@en ;
    skos:inScheme cs: ;
