:manganese-sulfate
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "manganese sulphate"@en ,
        "manganese(II) sulfate"@en ,
        "manganese(II) sulphate"@en ;
    skos:broader :mineral-commodities ;
    skos:definition "An inorganic compound with the chemical formula MnSO₄·H₂O. This pale pink, deliquescent solid is a commercially significant manganese salt. It is the precursor to manganese metal and many other chemical compounds. Manganese-deficient soil is remediated with this salt."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "manganese sulfate"@en ;
    schema:citation "https://en.wikipedia.org/wiki/Manganese(II)_sulfate"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

