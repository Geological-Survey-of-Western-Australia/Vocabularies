    skos:inScheme cs: ;
    skos:prefLabel "saponite"@en ;
    schema:citation
        "https://en.wikipedia.org/wiki/Saponite"^^xsd:anyURI ,
        "https://glossary.americangeosciences.org/term/saponite"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:selenium
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broader :industrial-commodities ;
    skos:definition "Selenium is a chemical element with the symbol Se and atomic number 34. It is a nonmetal and seldom occurs in its elemental state or as pure ore compounds in the Earth's crust. Selenium is found in metal sulfide ores, where it partially replaces the sulfur. Commercially, selenium is produced as a byproduct in the refining of these ores, most often during production. Minerals that are pure selenide or selenate compounds are known but rare. The chief commercial uses for selenium today are glassmaking and pigments. Selenium is a semiconductor and is used in photocells."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/selenium> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/selenium> ,
        <https://linked.data.gov.au/def/geo-commodities/selenium> ;
    skos:inScheme cs: ;
    skos:prefLabel "selenium"@en ;
    schema:citation "https://en.wikipedia.org/wiki/Selenium"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:serpentine
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broader :mineral-commodities ;
    skos:definition "A group of common rock-forming minerals having the general chemical formula (Mg,Al,Fe,Mn,Ni,Zn)²⁻₃(Si,Al,Fe)₂O₅(OH)₄. Serpentine minerals have a greasy or silky lustre, a slightly soapy feel, and a tough, conchoidal fracture; they are usually compact but may be granular or fibrous (see 'asbestos - serpentine' for the asbestiform variety), and are commonly green, greenish yellow, or greenish grey and often veined or spotted with green and white. They are always secondary minerals, derived by alteration of magnesium-rich silicate minerals (particularly olivines), and are found in both igneous and metamorphic rocks. Translucent varieties are used for ornamental and decorative purposes, often as a substitute for jade."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/serpentine> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/serpentine> ,
        <https://linked.data.gov.au/def/geo-commodities/serpentine> ;
    skos:inScheme cs: ;
    skos:prefLabel "serpentine"@en ;
    schema:citation
        "http://en.wikipedia.org/wiki/Serpentine_group"^^xsd:anyURI ,
        "https://glossary.americangeosciences.org/term/serpentine"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:sillimanite
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "aluminosilicate"@en ,
        "aluminosilicate polymorph"@en ,
        "fibrolite"@en ;
    skos:broadMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/aluminosilicate> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/aluminosilicate> ,
        <https://linked.data.gov.au/def/geo-commodities/aluminosilicate> ;
    skos:broader :mineral-commodities ;
    skos:definition "A brown, grey, pale green or white orthorhombic mineral with the chemical formula Al₂SiO₅. It is trimorphous with kyanite and andalusite. Sillimanite occurs in long, slender, needlelike crystals commonly found in wisplike or fibrous aggregates in schist and gneiss; it forms at the highest temperatures and pressures of a regionally metamorphosed sequence and is characteristic of the innermost zone of contact-metamorphosed sediments."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/sillimanite> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/sillimanite> ,
