        "https://glossary.americangeosciences.org/term/lignite"^^xsd:anyURI ,
        "https://www.mindat.org/min-9354.html"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:lime
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "CaO"@en ,
        "CaOH"@en ,
        "calcium hydroxide"@en ,
        "calcium oxide"@en ,
        "slaked lime"@en ;
    skos:broader :industrial-commodities ;
    skos:definition "An inorganic material composed primarily of calcium oxides and hydroxide. The word lime originates with its earliest use as building mortar and has the sense of sticking or adhering. Lime is used in large quantities as building and engineering materials (including limestone products, cement, concrete and mortar), as chemical feedstocks, and for sugar refining, among other uses."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/lime> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/lime> ,
        <https://linked.data.gov.au/def/geo-commodities/lime> ;
    skos:inScheme cs: ;
    skos:prefLabel "lime"@en ;
    schema:citation "https://en.wikipedia.org/wiki/Lime_(material)"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:limesand-grit-metallurgical
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "grit"@en ,
        "metallurgical grit"@en ,
        "metallurgical limesand"@en ;
    skos:broadMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/lime> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/lime> ,
        <https://linked.data.gov.au/def/geo-commodities/lime> ;
    skos:broader :limesand ;
    skos:definition "An unconsolidated sediment comprised mostly of shell and coral fragments and used for metallurgical processes. Limesand is used in steel manufacturing, beneficiation of copper ore, to make alumina and magnesia for use in aluminium and magnesium manufacturing, to extract uranium, and to recover gold and silver."@en ;
    skos:historyNote "du Plessis, CA, Lambert, H, Gärtner, RS, Ingram,K, Slabbert, W and Eksteen, JJ 2021, Lime use in gold processing – A review: Minerals Engineering, v. 174, 107231, doi.org/10.1016/j.mineng.2021.107231." ;
    skos:inScheme cs: ;
    skos:prefLabel "limesand / grit - metallurgical"@en ;
    schema:citation
        "https://dmpbookshop.eruditetechnologies.com.au/product/limestone-and-limesand-resources-of-western-australia.do"^^xsd:anyURI ,
        "https://www.lime.org/lime-basics/uses-of-lime/metallurgical-uses-of-lime/"^^xsd:anyURI ,
        "https://www.sciencedirect.com/science/article/pii/S089268752100460X"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:magnetite-specimen
