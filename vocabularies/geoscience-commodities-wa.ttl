:corundum-ruby
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "ruby"@en ;
    skos:broadMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/corundumGemstone> ,
