:praseodymium
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broadMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/LREE> ,
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/rareearthelement> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/LREE> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/rareearthelement> ,
        <https://linked.data.gov.au/def/geo-commodities/light-rare-earth-elements> ,
        <https://linked.data.gov.au/def/geo-commodities/rare-earth-element> ;
    skos:broader :light-rare-earth-elements ;
    skos:definition "Praseodymium is a chemical element with the symbol Pr and the atomic number 59. It is the third member of the lanthanide series and is considered to be one of the rare earth elements (REE). It is a soft, silvery, malleable and ductile metal, valued for its magnetic, electrical, chemical and optical properties. Many of praseodymium's industrial uses involve its ability to filter yellow light from light sources."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/praseodymium> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/praseodymium> ,
        <https://linked.data.gov.au/def/geo-commodities/praseodymium> ;
    skos:inScheme cs: ;
    skos:prefLabel "praseodymium"@en ;
    schema:citation "https://en.wikipedia.org/wiki/Praseodymium"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:praseodymium-oxide
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "Pr oxide"@en ,
        "Pr-oxide"@en ,
        "praseodymia"@en ,
        "praseodymium sesquioxide"@en ,
