:high-purity-silica
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "HPQ"@en ,
        "high purity quartz"@en ,
        "high purity quartz sand"@en ,
        "high purity silica"@en ,
        "high-purity quartz"@en ;
    skos:broader :quartz ;
    skos:definition "Naturally occurring quartz/silica (in veins, blows or crystals) of extremely high purity (HPS). HPS can also be derived from silica sand. HPS is used in optical fibres and electronics including solar panels; also used for crucibles and other equipment for growing silicon wafers in the semiconductor industry."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "high-purity silica (HPS)"@en ;
    schema:citation
