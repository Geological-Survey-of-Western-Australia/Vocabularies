:columbite
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "columbate"@en ,
        "dianite"@en ,
        "greenlandite"@en ,
        "niobite"@en ,
        "niobite-tantalite"@en ;
    skos:broader :tantalite-and-columbite ;
    skos:definition "Columbite, of general chemical formula (Fe²⁺,Mn²⁺)Nb₂O₆, is a black mineral group that is an ore of niobium. It has a submetallic lustre and a high density and is a niobate of iron and manganese. Columbite was long used as a species name but is now split between the iron end-member columbite-(Fe) and the manganese end-member columbite-(Mn) and consequently is the name of an isomorphous series. The name columbite usually refers to (the more common) columbite-(Fe), formerly known as ferrocolumbite."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "columbite"@en ;
    schema:citation
        "https://en.wikipedia.org/wiki/Columbite"^^xsd:anyURI ,
        "https://www.mindat.org/min-8667.html"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:condensate
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "condy"@en ,
        "distillate"@en ,
        "natural gas condensate"@en ,
