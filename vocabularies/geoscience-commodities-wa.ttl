    skos:inScheme cs: ;
    skos:prefLabel "sepiolite"@en ;
    schema:citation
        "http://en.wikipedia.org/wiki/Sepiolite"^^xsd:anyURI ,
        "https://glossary.americangeosciences.org/term/sepiolite"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:silica-flour
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broadMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/silica> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/silica> ,
        <https://linked.data.gov.au/def/geo-commodities/silica> ;
    skos:broader :silica-sand ;
    skos:definition "Silica flour is nearly pure SiO₂ finely ground. Silica flour has been used as a polisher or buffer, as well as paint extender, abrasive and filler for cosmetics. Silica flour has been associated with all types of silicosis, including acute silicosis."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "silica flour"@en ;
    schema:citation "https://en.wikipedia.org/wiki/Silicosis"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:slimes
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broader :industrial-commodities ;
    skos:definition "Primary slimes are extremely fine particles derived from ore, associated rock, clay, or altered rock. They are usually found in old dumps and in ore deposits that have been exposed to climatic action; they include clay, alumina, hydrated iron, near-colloidal common earths, and weathered feldspars. Secondary slimes are very finely ground minerals from the true ore."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "slimes"@en ;
    schema:citation "https://www.mindat.org/glossary/slime"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:soda-ash
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "sodium carbonate"@en ,
        "trona"@en ;
    skos:broader :mineral-commodities ;
    skos:definition "Commercial term for sodium carbonate, which has a chemical formula of Na₂CO₃. Prepared in processing plants from the mineral trona and from lake brines, or by synthesis from salt and limestone. Soda ash is used as a water softener, as a flux in glass manufacturing and as a base in many applications."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/sodaash> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/sodaash> ,
