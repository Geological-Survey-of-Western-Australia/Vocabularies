:quartz-smoky
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "smokey quartz"@en ;
    skos:broadMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/gemstone> ,
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/quartz> ,
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/quartz-gemstone> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/gemstone> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/quartz> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/quartz-gemstone> ,
        <https://linked.data.gov.au/def/geo-commodities/gemstone> ,
        <https://linked.data.gov.au/def/geo-commodities/quartz> ,
        <https://linked.data.gov.au/def/geo-commodities/quartz-gemstone> ;
    skos:broader :quartz-gem ;
    skos:definition "Smoky quartz is a grey, translucent gem-quality variety of quartz. It ranges in clarity from almost complete transparency to a brownish-grey crystal that is almost opaque. Some can also be black. . The colour of smoky quartz is produced when natural radiation, emitted from the surrounding rock, activates colour centres around aluminium impurities within the crystalline quartz."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/smokeyquartz> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/smokeyquartz> ,
        <https://linked.data.gov.au/def/geo-commodities/smokey-quartz> ;
    skos:inScheme cs: ;
    skos:prefLabel "quartz - smoky"@en ;
    schema:citation
        "https://en.wikipedia.org/wiki/Quartz#Smoky_quartz"^^xsd:anyURI ,
        "https://www.mindat.org/min-3689.html"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:radium
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broader :mineral-commodities ;
    skos:definition "Radium is a chemical element with symbol Ra and atomic number 88. Radium is an almost pure-white alkaline earth metal, but it readily oxidizes on exposure to air, becoming black in colour. All isotopes of radium are radioactive. In nature, radium is found in uranium and (to a lesser extent) thorium ores in trace amounts. Radium is used in nuclear medicine."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/radium> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/radium> ,
        <https://linked.data.gov.au/def/geo-commodities/radium> ;
    skos:inScheme cs: ;
    skos:prefLabel "radium"@en ;
    schema:citation "https://en.wikipedia.org/wiki/Radium"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:rhenium
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broader :platinum-group-elements ;
    skos:definition "Rhenium is a chemical element with the symbol Re and atomic number 75. It is a silvery grey, heavy, third-row transition metal in group 7 of the periodic table. Rhenium is one of the rarest elements in the Earth's crust and is mainly obtained as a byproduct of the extraction and refinement of molybdenum and copper ores. Nickel-based superalloys of rhenium are used in combustion chambers, turbine blades, and exhaust nozzles of jet engines. Rhenium is also used as a catalyst."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/rhenium> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/rhenium> ,
        <https://linked.data.gov.au/def/geo-commodities/rhenium> ;
    skos:inScheme cs: ;
    skos:prefLabel "rhenium"@en ;
    schema:citation "https://en.wikipedia.org/wiki/Rhenium"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:rhodonite
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "manganese spar"@en ,
        "manganolite"@en ,
        "rhodarsenite"@en ;
    skos:broadMatch <https://linked.data.gov.au/def/geo-commodities/gemstone> ;
    skos:broader :mineral-commodities ;
    skos:definition "A pale red, rose-red, or flesh-pink to brownish red or red-brown triclinic pyroxenoid mineral with the chemical formula (Mn²⁺,Fe²⁺,Mg,Ca)SiO₃. It sometimes contains zinc and is often marked by black streaks and veins of manganese oxide. Rhodonite is used as an ornamental stone."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/rhodonite> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/rhodonite> ,
