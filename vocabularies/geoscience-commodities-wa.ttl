.

:copper-equivalent
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broader :metal-equivalents ;
    skos:definition "Copper equivalent (CuEq) refers to a way of reporting mineral resources, and refers to the equivalent quantity or grade of copper calculated using assumed metal prices for copper, gold and, where applicable, molybdenum; i.e. the percentage of marketable metals or minerals contained in mineralized materials determined by converting all other metals other than copper to equivalent copper on the basis of a market price for such metals at a given time (e.g. the equivalent quantity or grade of copper estimated by converting the molybdenum quantity or grade using a Moly Factor (MF) and adding it to the copper quantity or grade, means copper equivalent grade, calculated using assumed metal prices for copper). Definition from https://www.lawinsider.com/dictionary/copper-equivalent."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "copper equivalent"@en ;
    schema:citation "https://www.lawinsider.com/dictionary/copper-equivalent"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:corundum-emery
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "corundite"@en ,
        "emery"@en ,
        "emery rock"@en ;
    skos:broadMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/corundum> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/corundum> ,
        <https://linked.data.gov.au/def/geo-commodities/corundum> ;
    skos:broader :industrial-commodities ;
    skos:definition "A grey to black granular impure variety of corundum, which contains varying amounts of iron oxides (usually magnetite or hematite). It is used in granular form for polishing and grinding. It occurs as masses in marble and as segregations in igneous rocks. The term emery also refers to a natural abrasive composed essentially of pulverized impure corundum, or the commercial product obtained by crushing emery rock."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "corundum - emery"@en ;
    schema:citation
        "https://en.wikipedia.org/wiki/Emery_(rock)"^^xsd:anyURI ,
        "https://glossary.americangeosciences.org/term/emery"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:corundum-undifferentiated
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broadMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/corundum> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/corundum> ,
        <https://linked.data.gov.au/def/geo-commodities/corundum> ;
    skos:broader :corundum ;
    skos:definition "A mineral with the chemical formula Al₂O₃ but otherwise uncategorized; may include legacy projects for which further information is not available (and may include industrial occurrences)"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "corundum - undifferentiated"@en ;
    schema:citation "https://en.wikipedia.org/wiki/Corundum"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:dimension-stone-undiff
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broader :industrial-commodities ;
    skos:definition "Dimension stone is a natural rock material quarried for the purpose of obtaining blocks or slabs that meet specifications as to size (width, length, and thickness) and shape. Dimension stones are used for both exteriors (building cladding, paving) and interiors. This concept is included in the vocabulary because of the volume of unspecified legacy data — its usage is discouraged, as a more specific term (i.e. the actual rock) should be used instead."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/dimensionstone> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/dimensionstone> ,
        <https://linked.data.gov.au/def/geo-commodities/dimension-stone> ;
    skos:historyNote "Barton, WR, 1968, Dimension stone: US Bureau of Mines Information Circular 8391, p. 4." ;
    skos:inScheme cs: ;
    skos:prefLabel "dimension stone - undifferentiated"@en ;
    skos:relatedMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/miscellaneousdimensionstones> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/miscellaneousdimensionstones> ,
        <https://linked.data.gov.au/def/geo-commodities/miscellaneous-dimension-stones> ;
    schema:citation
        "http://en.wikipedia.org/wiki/Dimension_stone"^^xsd:anyURI ,
        "https://digital.library.unt.edu/ark:/67531/metadc170799/"^^xsd:anyURI ,
        "https://www.usgs.gov/centers/national-minerals-information-center/dimension-stone-statistics-and-information"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:diorite
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broader :industrial-commodities ;
    skos:definition "A group plutonic rocks intermediate in composition between acidic and basic, characteristically composed of dark-coloured amphibole (especially hornblende), sodic plagioclase (oligoclase, andesine), pyroxene, and sometimes a small amount of quartz. The term diorite is also used to refer to any rock in the diorite group. Diorite is the approximate intrusive equivalent of andesite. In typical diorite, plagioclase contains less than 50% anorthite, hornblende predominates over pyroxene, and mafic minerals total less than 50% of the rock. Most common uses are as dimension stone or crushed as aggregate for construction purposes."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "diorite"@en ;
    schema:citation "https://glossary.americangeosciences.org/term/diorite"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:dolomite
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broader :carbonate ;
    skos:definition "An anhydrous calcium–magnesium carbonate mineral, with an ideal chemical formula of CaMg(CO₃)₂. Dolomite is used as a pH buffer and magnesium source in agriculture, an industrial catalyst, a flux during smelting of iron and steel and in the production of float glass and ceramics."@en ;
    skos:exactMatch <https://linked.data.gov.au/def/geo-commodities/dolomite> ;
    skos:inScheme cs: ;
    skos:prefLabel "dolomite"@en ;
    schema:citation "https://linked.data.gov.au/def/geo-commodities/dolomite"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:felsic-rock
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broader :industrial-commodities ;
    skos:definition "Felsic is a mnemonic adjective derived from (fe) for feldspar, (l) for feldspathoid, and (si) for silica + c, and applied to light-coloured rocks containing an abundance of one or all of these constituents, irrespective of its mode of formation. Common components include quartz or feldspathoid, feldspar and muscovite."@en ;
    skos:inScheme cs: ;
    skos:narrowMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/granite> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/granite> ,
        <https://linked.data.gov.au/def/geo-commodities/granite> ,
        <https://linked.data.gov.au/def/geo-commodities/rhyolite> ;
    skos:prefLabel "felsic rock"@en ;
    schema:citation "https://glossary.americangeosciences.org/term/felsic"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:ferrochrome
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "ferrochromium"@en ;
    skos:broader :mineral-commodities ;
    skos:definition "An alloy of chromium and iron, generally containing 50 to 70% chromium by weight. Ferrochrome is produced by electric arc carbothermic reduction of chromite. Steel production, especially that of stainless steel with chromium content of 10 to 20%, is the largest consumer and the main application of ferrochrome."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "ferrochrome"@en ;
    schema:citation "https://en.wikipedia.org/wiki/Ferrochrome"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:gabbro
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "trap rock"@en ;
    skos:broader :mafic-igneous-rock ;
    skos:definition "A group of dark-coloured, phaneritic, mafic intrusive or subvolcanic igneous rocks composed principally of calcic plagioclase (commonly labradorite or bytownite) and clinopyroxene (augite), with or without olivine and orthopyroxene; also, any member of that group. It is the approximate coarse-grained equivalent of basalt. Apatite and magnetite or ilmenite are common accessory minerals."@en ;
    skos:exactMatch <https://linked.data.gov.au/def/geo-commodities/gabbro> ;
    skos:inScheme cs: ;
    skos:prefLabel "mafic igneous rock - gabbro"@en ;
    schema:citation
        "https://en.wikipedia.org/wiki/Gabbro"^^xsd:anyURI ,
        "https://glossary.americangeosciences.org/term/gabbro"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:gadolinite
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "ytterbite"@en ;
    skos:broader :mineral-commodities ;
    skos:definition "A silicate mineral consisting principally of the silicates of cerium, lanthanum, neodymium, yttrium, beryllium, and iron with the chemical formula (Ce,La,Nd,Y)₂FeBe₂Si₂O₁₀. It is called gadolinite-(Ce) or gadolinite-(Y), depending on the prominent composing element (Y if yttrium predominates, and Ce if cerium). Gadolinite is quite abundant and a potential source of yttrium subgroup rare earth elements."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "gadolinite"@en ;
    schema:citation "https://en.wikipedia.org/wiki/Gadolinite"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:gallium
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broader :mineral-commodities ;
    skos:definition "A chemical element with symbol Ga and atomic number 31. Elemental gallium does not occur in free form in nature, but as gallium(III) compounds that are in trace amounts in zinc ores and in bauxite. Gallium is a soft silvery metal, and elemental gallium is a brittle solid at low temperatures. Gallium is predominantly used in electronics."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/gallium> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/gallium> ,
        <https://linked.data.gov.au/def/geo-commodities/gallium> ;
    skos:inScheme cs: ;
    skos:prefLabel "gallium"@en ;
    schema:citation "https://en.wikipedia.org/wiki/Gallium"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:garnet
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broader :mineral-commodities ;
    skos:definition "A group of minerals with the chemical formula: A₃B₂(SiO₄)₃, where A = Ca, Mg, Fe²⁺ or Mn²⁺, and B = Al, Fe³⁺, Mn³⁺, V³⁺ or Cr³⁺. Garnet group minerals include the end members almandine (Fe–Al), andradite (Ca–Fe), grossular (Ca–Al), pyrope (Mg–Al), spessartine (Mn–Al), uvarovite (Ca–Cr) and goldmanite (Ca–V). Garnets are brittle and transparent to subtransparent, with a vitreous lustre, no cleavage, and a variety of colours, dark red being the most common. They occur as accessory minerals in a wide range of igneous rocks, but are most commonly found as distinctive euhedral cubic crystals in metamorphic rocks (gneiss, mica schist, marble) and as grains within heavy mineral sand deposits; garnets may also be massive or granular. Garnet is used as a semiprecious gem and as an abrasive."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/garnet> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/garnet> ,
        <https://linked.data.gov.au/def/geo-commodities/garnet> ;
    skos:inScheme cs: ;
    skos:narrower :garnet-specimen ;
    skos:prefLabel "garnet"@en ;
    schema:citation
        "http://en.wikipedia.org/wiki/Garnet"^^xsd:anyURI ,
        "https://glossary.americangeosciences.org/term/garnet"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:gypsum
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broadMatch <https://linked.data.gov.au/def/geo-commodities/evaporite> ;
    skos:broader :mineral-commodities ;
    skos:definition "A widely distributed mineral consisting of aquated calcium sulfate with the chemical formula CaSO₂·2H₂O . It is the most common sulfate mineral and is frequently associated with halite and anhydrite in evaporites, forming thick, extensive beds interstratified with limestone, shale, and clay (especially in rocks of Permian and Triassic age). Gypsum is soft (hardness of 2 on the Mohs scale) and white or colourless when pure. It occurs as massive (alabaster), fibrous (satin spar) or in monoclinic crystals (selenite). Gypsum is used chiefly as a soil amendment, as a retarder in portland cement, and in making Plaster of Paris."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/gypsum> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/gypsum> ,
        <https://linked.data.gov.au/def/geo-commodities/gypsum> ;
    skos:inScheme cs: ;
    skos:prefLabel "gypsum"@en ;
    schema:citation
        "https://en.wikipedia.org/wiki/Gypsum"^^xsd:anyURI ,
        "https://glossary.americangeosciences.org/term/gypsum"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:halloysite
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broadMatch <https://linked.data.gov.au/def/geo-commodities/clay> ;
    skos:broader :industrial-commodities ;
    skos:definition "A 1:1 aluminosilicate clay mineral with the empirical formula Al₂Si₂O₅(OH)₄. Its main constituents are aluminium (20.90%), silicon (21.76%) and hydrogen (1.56%). Halloysite typically forms by hydrothermal alteration of aluminosilicate minerals. It can occur intermixed with dickite, kaolinite, montmorillonite and other clay minerals. The formation of halloysite is due to hydrothermal alteration, and it is often found near carbonate rocks. The primary commercial application of halloysite is in porcelain and bone china, but due to its purity, it is now being examined for use in the production of High Purity Alumina (HPA)."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/halloysite> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/halloysite> ,
        <https://linked.data.gov.au/def/geo-commodities/halloysite> ;
    skos:inScheme cs: ;
    skos:prefLabel "halloysite"@en ;
    schema:citation "https://en.wikipedia.org/wiki/Halloysite"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:hematite-pigment
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "hematite pigment"@en ,
        "mineral pigment"@en ;
    skos:broadMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/hematite> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/hematite> ,
        <https://linked.data.gov.au/def/geo-commodities/hematite> ;
    skos:broader :hematite ;
    skos:definition "Hematite and its alteration products are common natural iron oxides used as pigments, i.e. to give colour, opacity, or body to a paint, stucco, plaster or similar material: hematite for red, goethite and limonite (hydrated iron oxides) for yellow and brown (ochres, siennas, and umbers), and magnetite for black. They are valued for their resistance to colour-change (especially from exposure to sunlight), chemical resistance, stability under ambient environmental conditions, non-toxicity and relatively low cost. Natural iron oxide pigments were used as colourants in early civilizations for body decoration and paintings on cave walls, which reveal details of prehistoric cultures."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "hematite - pigment"@en ;
    schema:citation
        "https://glossary.americangeosciences.org/term/mineralpigment"^^xsd:anyURI ,
        "https://www.earthmagazine.org/article/mineral-resource-month-iron-oxide-pigments/"^^xsd:anyURI ,
        "https://www.naturalpigments.com/artist-materials/violet-colour-hematite-earth-pigments"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:hydrogen-natural
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "geologic hydrogen"@en ,
        "gold hydrogen"@en ,
        "native hydrogen"@en ,
        "natural hydrogen"@en ,
        "white hydrogen"@en ;
    skos:broader :hydrogen ;
    skos:definition "Naturally occurring molecular hydrogen on or in the Earth (as opposed to hydrogen produced in the laboratory or in industry). Often called white or gold hydrogen, which distinguishes it from hydrogen produced from renewable energy sources (green hydrogen), and from hydrogen obtained from fossil sources (grey, brown or black hydrogen) or from the electrolysis of water. Natural hydrogen may be renewable, non-polluting and allows for lower cost operation compared to industrial hydrogen. Natural hydrogen has been identified in many source rocks in areas beyond the sedimentary basins where oil companies typically operate."@en ;
    skos:inScheme cs: ;
    skos:narrower :hydrogen-orange ;
    skos:prefLabel "hydrogen - natural"@en ;
    schema:citation "https://en.wikipedia.org/wiki/Natural_hydrogen"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:iridium
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broader :platinum-group-elements ;
    skos:definition "A chemical element with the symbol Ir and atomic number 77. A very hard, brittle, silvery-white transition metal of the platinum group and is one of the most corrosion-resistant metals. The dominant uses of iridium are the metal itself and its alloys, as in high-performance spark plugs, crucibles for recrystallization of semiconductors at high temperatures, and electrodes for the production of chlorine in the chloralkali process."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "iridium"@en ;
    schema:citation "https://en.wikipedia.org/wiki/Iridium"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:kaolin
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "china clay"@en ;
    skos:broader :industrial-commodities ;
    skos:definition "A claystone rich in kaolinite, a clay mineral with the chemical formula Al₂Si₂O₅(OH)₄. Sometimes used as a mineral name but usually for variably pure rock or industrial material. Mostly sedimentary but may be formed by in situ weathering."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/kaolin> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/kaolin> ,
        <https://linked.data.gov.au/def/geo-commodities/kaolin> ;
    skos:inScheme cs: ;
    skos:prefLabel "kaolin"@en ;
    schema:citation
        "http://en.wikipedia.org/wiki/China_clay"^^xsd:anyURI ,
        "http://resource.geosciml.org/classifier/cgi/commodity-code/kaolin"^^xsd:anyURI ,
        "https://www.mindat.org/min-5702.html"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:kyanite
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "aluminosilicate"@en ,
        "aluminosilicate polymorph"@en ;
    skos:broadMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/aluminosilicate> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/aluminosilicate> ,
        <https://linked.data.gov.au/def/geo-commodities/aluminosilicate> ;
    skos:broader :mineral-commodities ;
    skos:definition "A mainly blue but variously coloured triclinic mineral with the chemical formula Al₂SiO₅. It is trimorphous with andalusite and sillimanite. Kyanite occurs in long, thin, bladed crystals and crystalline aggregates in schist, gneiss and granitic pegmatite. It forms at medium temperatures and high pressures in regionally metamorphosed sequences. Kyanite is used primarily in refractory and ceramic products, including porcelain plumbing fixtures and dishware. It is also used in electronics, electrical insulators and abrasives."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/kyanite> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/kyanite> ,
