    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:sapphirine
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "saphirine"@en ;
    skos:broadMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/gemstone> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/gemstone> ,
        <https://linked.data.gov.au/def/geo-commodities/gemstone> ;
    skos:broader :mineral-commodities ;
    skos:definition "A green or pale blue, dense, hard mineral crystallizing in monoclinic and triclinic forms, with the chemical formula Mg₇Al₁₈Si₃O₄₀. It is a principal constituent of certain high-grade, silica-deficient metamorphic rocks and occurs usually in granular form. Very small, gem-quality stones are faceted for collectors."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/sapphirine> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/sapphirine> ,
        <https://linked.data.gov.au/def/geo-commodities/sapphirine> ;
    skos:inScheme cs: ;
    skos:prefLabel "sapphirine"@en ;
    schema:citation
        "https://glossary.americangeosciences.org/term/sapphirine"^^xsd:anyURI ,
