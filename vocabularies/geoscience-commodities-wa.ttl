:malachite
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broadMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/gemstone> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/gemstone> ,
        <https://linked.data.gov.au/def/geo-commodities/gemstone> ;
    skos:broader :mineral-commodities ;
    skos:definition "A green, very common secondary copper mineral with a widely variable habit and the formula Cu₂(CO₃)(OH)₂. It is an ore of copper and is a common secondary mineral associated with azurite in the upper (oxidized) zones of copper deposits. Malachite occurs in masses with smooth mamillated or botryoidal surfaces, and it is often concentrically banded in different shades of green. It is used to make ornamental objects. Single crystals and clusters of distinguishable crystals are uncommon, but when found they are typically acicular to prismatic."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/malachite> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/malachite> ,
        <https://linked.data.gov.au/def/geo-commodities/malachite> ;
    skos:historyNote "Mindat" ;
    skos:inScheme cs: ;
    skos:prefLabel "malachite"@en ;
