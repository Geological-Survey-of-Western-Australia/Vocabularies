:chrysoberyl
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "chrysopal"@en ,
        "cymophane"@en ,
        "gold beryl"@en ;
    skos:broadMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/gemstone> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/gemstone> ,
        <https://linked.data.gov.au/def/geo-commodities/gemstone> ;
    skos:broader :mineral-commodities ;
    skos:definition "A hard orthorhombic mineral with the chemical formula BeAl₂O₄. It is usually yellow, pale green or brown, contains a small amount of iron, and is used as a gem. Chrysoberyl is known for its three main gem varieties: faceted chrysoberyl, found in yellowish green to green, yellow and shades of brown; 'cat's eye' or 'cymophane' with a single dynamic sliver of light reflecting from needle like inclusions in the centre of the gem; alexandrite displaying varying colours based on the wavelengths it is refracting."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/chrysoberyl> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/chrysoberyl> ,
