:magnesium
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broader :mineral-commodities ;
    skos:definition "A chemical element with the symbol Mg and atomic number 12. It is a shiny grey metal having a low density, low melting point and high chemical reactivity. Like the other alkaline earth metals, it occurs naturally only in combination with other elements and it almost always has an oxidation state of +2. Magnesium is used primarily as a component in strong and lightweight alloys that contain aluminium."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/magnesium> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/magnesium> ,
        <https://linked.data.gov.au/def/geo-commodities/magnesium> ;
    skos:inScheme cs: ;
    skos:prefLabel "magnesium"@en ;
    schema:citation "https://en.wikipedia.org/wiki/Magnesium"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:magnesium-chloride
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "Bischofite"@en ;
    skos:broader :mineral-commodities ;
    skos:definition "An inorganic compound with the formula MgCl₂. It forms hydrates MgCl₂·nH₂O, where n can range from 1 to 12. These salts are colourless or white solids that are highly soluble in water. These compounds and their solutions, both of which occur in nature, have a variety of practical uses. Anhydrous magnesium chloride is the principal precursor to magnesium metal, which is produced on a large scale. Hydrated magnesium chloride is the form most readily available."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "magnesium chloride"@en ;
    schema:citation "https://en.wikipedia.org/wiki/Magnesium_chloride"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:magnesium-hydroxide
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "brucite"@en ;
    skos:broader :mineral-commodities ;
    skos:definition "An inorganic compound with the chemical formula Mg(OH)₂. It occurs in nature as the mineral brucite. It is a white solid with low solubility in water. Magnesium hydroxide is a common component of antacids, such as milk of magnesia."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "magnesium hydroxide"@en ;
    schema:citation "https://en.wikipedia.org/wiki/Magnesium_hydroxide"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:magnesium-oxide
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "magnesia"@en ;
    skos:broader :mineral-commodities ;
    skos:definition "A white hygroscopic solid mineral with the formula MgO that occurs naturally as periclase and is a source of magnesium. Magnesium hydroxide forms in the presence of water (MgO + H₂O → Mg(OH)₂), but this process can be reversed by heating it to remove moisture. Magnesium oxide has a large number of applications, including in heating elements, fireproofing, gas mantles and in medical treatments."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/magnesia> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/magnesia> ,
        <https://linked.data.gov.au/def/geo-commodities/magnesia> ;
    skos:inScheme cs: ;
    skos:prefLabel "magnesium oxide"@en ;
    schema:citation "https://en.wikipedia.org/wiki/Magnesium_oxide"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:magnesium-sulfate
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "Epsom salt"@en ,
        "magnesium sulphate"@en ;
    skos:broader :mineral-commodities ;
    skos:definition "A chemical compound, a salt with the formula MgSO₄, consisting of magnesium cations Mg²⁺ (20.19% by mass) and sulfate anions SO²⁻₄. It is a white crystalline solid, soluble in water but not in ethanol. The most common form is the heptahydrate MgSO₄·7H₂O, known as Epsom salt, which is a household chemical with many traditional uses, including bath salts. The main use of magnesium sulfate is in agriculture, to correct soils deficient in magnesium."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "magnesium sulfate"@en ;
    schema:citation "https://en.wikipedia.org/wiki/Magnesium_sulfate"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

