:chrysoberyl-alexandrite
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broadMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/gemstone> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/gemstone> ,
        <https://linked.data.gov.au/def/geo-commodities/gemstone> ;
    skos:broader :chrysoberyl ;
    skos:definition "A transparent, chromian variety of chrysoberyl with the chemical formula BeAl₂O₄. Exhibits a grass-green or emerald-green colour in natural light and wine-red to brownish-red colour (amethystine) in artificial light (called the Alexandrite effect)."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "chrysoberyl - alexandrite"@en ;
    schema:citation
        "https://glossary.americangeosciences.org/term/alexandrite"^^xsd:anyURI ,
        "https://www.mindat.org/min-109.html"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:chrysocolla
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broadMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/gemstone> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/gemstone> ,
        <https://linked.data.gov.au/def/geo-commodities/gemstone> ;
    skos:broader :mineral-commodities ;
    skos:definition "A blue, blue-green, or emerald-green amorphous mineral with the chemical formula Cu₂(OH)₄[Si₂O₃(OH)₂]. It is commonly associated with other secondary copper minerals and is typically found as glassy botryoidal or rounded masses or bubbly crusts, and as vein fillings. Acicular or fibrous chrysocolla 'crystals' are pseudomorphs. Chrysocolla occurs as encrustations and thin seams in the zone of weathering of copper ores. Due to its vivid colours, chrysocolla has been popular for use as a gemstone for carvings and ornamental use since antiquity. Its chemical composition was formerly given as: CuSiO₂·2H₂O."@en ;
    skos:exactMatch <https://linked.data.gov.au/def/geo-commodities/chrysocolla> ;
    skos:inScheme cs: ;
    skos:prefLabel "chrysocolla"@en ;
    schema:citation
        "https://en.wikipedia.org/wiki/Chrysocolla"^^xsd:anyURI ,
        "https://glossary.americangeosciences.org/term/chrysocolla"^^xsd:anyURI ,
        "https://www.mindat.org/min-1040.html"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

