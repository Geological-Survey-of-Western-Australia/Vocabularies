    skos:inScheme cs: ;
    skos:prefLabel "platinum"@en ;
    schema:citation "https://en.wikipedia.org/wiki/Platinum"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

