:beryl-undifferentiated
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broadMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/beryl> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/beryl> ,
        <https://linked.data.gov.au/def/geo-commodities/beryl> ;
    skos:broader :beryl ;
    skos:definition "An otherwise uncategorized source of beryl, a beryllium-bearing aluminium silicate mineral with the chemical formula Be₃Al₂Si₆O₁₈; may include legacy projects for which further information is not available. Beryl is used as a source of beryllium, a high-strength, lightweight metal with a high resistance to corrosion. Beryllium has a wide variety of applications, including the manufacture of electrical equipment, nuclear reactors, electronic components and aerospace components."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "beryl - undifferentiated"@en ;
    schema:citation "https://www.ga.gov.au/education/minerals-energy/australian-mineral-facts/emerald"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:beryllium
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broader :mineral-commodities ;
    skos:definition "A chemical element with the symbol Be and atomic number 4. It is a divalent element which occurs naturally only in combination with other elements. Notable gemstones which contain beryllium include beryl (aquamarine, emerald) and chrysoberyl."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/beryllium> ,
