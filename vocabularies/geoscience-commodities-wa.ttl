.

:palygorskite
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "Fullers earth"@en ,
        "attapulgite"@en ,
        "clay"@en ;
    skos:broadMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/Fullersearth> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/Fullersearth> ,
        <https://linked.data.gov.au/def/geo-commodities/fullers-earth> ;
    skos:broader :mineral-commodities ;
    skos:definition "A white, greyish, yellowish, or greyish green chain-structure clay mineral with the chemical formula (Mg,Al)₂Si₄O₁₀(OH)·4H₂O. It crystallizes in several monoclinic and orthorhombic polytypes. One of the types of Fuller's earth."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/palygorskite> ,
