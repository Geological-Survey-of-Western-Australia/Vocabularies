    schema:citation "https://en.wikipedia.org/wiki/Tantalum_pentoxide"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

<https://linked.data.gov.au/def/geoscience-commodities-wa/ta–nb-pentoxide>
