.

:clay-white
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "bolus alba"@en ,
        "china clay"@en ,
        "halloysite"@en ,
        "kaolin"@en ,
        "white clay"@en ,
        "white-firing clay"@en ;
    skos:broadMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/clay> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/clay> ,
        <https://linked.data.gov.au/def/geo-commodities/clay> ;
    skos:broader :clay ;
    skos:definition "A soft, relatively nonplastic but dispersible, usually white or nearly white claystone composed primarily of minerals of the kaolin group, principally kaolinite but often containing a variable proportion of mica or quartz. White clay, or kaolin, is white or nearly white on firing; a porcelain clay or natural (unwashed) china clay; used in the manufacture of ceramics, refractories and paper, as well as in the processing of high-purity alumina (HPA)."@en ;
    skos:exactMatch
