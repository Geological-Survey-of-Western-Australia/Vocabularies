        "https://www.mindat.org/min-52521.html"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:thorium-dioxide
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "thoria"@en ,
        "thorianite"@en ,
        "thorium oxide"@en ,
        "thorium(IV) oxide"@en ;
    skos:broader :mineral-commodities ;
    skos:definition "Thorium dioxide (ThO2), also called thorium (IV) oxide, is a crystalline solid, often white or yellow in colour. Also known as thoria, it is produced mainly as a byproduct of lanthanide and uranium production. Thorianite is the name of the mineralogical form of thorium dioxide. It is moderately rare and crystallizes in an isometric system. Thorium dioxide has applications in nuclear fuels, alloys, catalysis, radiocontrast agents, lamp mantles and glass manufacture."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/thoriumdioxide> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/thoriumdioxide> ;
    skos:inScheme cs: ;
    skos:prefLabel "thorium dioxide"@en ;
    schema:citation "https://en.wikipedia.org/wiki/Thorium_dioxide"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

