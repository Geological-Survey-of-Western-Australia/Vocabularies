:actinolite
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "cat's eye actinolite"@en ,
        "kidney stone"@en ;
    skos:broadMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/tremolite-actinolite> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/tremolite-actinolite> ,
        <https://linked.data.gov.au/def/geo-commodities/tremolite-actinolite> ;
    skos:broader :mineral-commodities ;
    skos:definition "Actinolite is a bright green or greyish green monoclinic mineral of the amphibole group and an intermediate member of the actinolite–tremolite series with the chemical formula Ca₂(Mg,Fe)₅Si₈O₂₂(OH)₂. It is commonly found in metamorphic rocks, with some forms used as gemstones (e.g. nephrite, one of the two types of jade, or the chatoyant form known as cat's-eye actinolite). Actinolite can occur as a fibrous/asbestiform aggregate of crystals (see asbestos actinolite) and is recognized as one of the six types of asbestos."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "actinolite"@en ;
    schema:citation
        "https://en.wikipedia.org/wiki/Actinolite"^^xsd:anyURI ,
        "https://glossary.americangeosciences.org/term/actinolite"^^xsd:anyURI ,
        "https://www.mindat.org/min-18.html"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:agate-moss
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "medfordite"@en ,
        "mocha stone"@en ,
        "moss agate"@en ;
    skos:broadMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/agate> ,
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/gemstone> ,
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/silica-gemstone> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/agate> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/gemstone> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/silica-gemstone> ,
        <https://linked.data.gov.au/def/geo-commodities/agate> ,
        <https://linked.data.gov.au/def/geo-commodities/gemstone> ,
        <https://linked.data.gov.au/def/geo-commodities/silica-gemstone> ;
    skos:broader :chalcedony-agate ;
    skos:definition "A translucent chalcedony containing predominantly green mineral inclusions of actinolite or of other green minerals (e.g. chlorite, hornblende), arranged in dendritic patterns resembling trees, ferns, leaves, moss, and similar vegetation. Moss agate may also contain brown or black dendrites of iron or manganese oxides. It is not a true form of agate, as it lacks agate's defining feature of concentric banding."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/mossagate> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/mossagate> ,
        <https://linked.data.gov.au/def/geo-commodities/moss-agate> ;
    skos:inScheme cs: ;
    skos:prefLabel "agate - moss"@en ;
    schema:citation
        "http://en.wikipedia.org/wiki/Moss_agate"^^xsd:anyURI ,
        "https://www.gemdat.org/gem-2791.html"^^xsd:anyURI ,
        "https://www.mindat.org/min-2791.html"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:agate-onyx
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "black onyx"@en ,
        "onyx"@en ,
        "sardonyx"@en ;
    skos:broadMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/agate> ,
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/gemstone> ,
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/silica-gemstone> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/agate> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/gemstone> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/silica-gemstone> ,
        <https://linked.data.gov.au/def/geo-commodities/agate> ,
        <https://linked.data.gov.au/def/geo-commodities/gemstone> ,
        <https://linked.data.gov.au/def/geo-commodities/silica-gemstone> ;
    skos:broader :chalcedony-agate ;
    skos:definition "A (usually) black and white banded variety of agate, or sometimes a monochromatic agate with dark and light parallel bands (brown and white for example). Onyx is formed by bands of chalcedony in alternating colours. It is cryptocrystalline, consisting of fine intergrowths of the silica minerals quartz and moganite. Sardonyx is a variant in which the coloured bands are sard (shades of red) rather than black. Black onyx is perhaps the most famous variety but is not as common as onyx with coloured bands."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/onyx> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/onyx> ,
        <https://linked.data.gov.au/def/geo-commodities/onyx> ;
    skos:inScheme cs: ;
    skos:prefLabel "agate - onyx"@en ;
    schema:citation
        "http://resource.geosciml.org/classifier/cgi/commodity-code/onyx"^^xsd:anyURI ,
        "http://www.quartzpage.de/agate.html#onyx"^^xsd:anyURI ,
        "https://glossary.americangeosciences.org/term/onyx"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

