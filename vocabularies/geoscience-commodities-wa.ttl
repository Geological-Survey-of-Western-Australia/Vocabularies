    skos:inScheme cs: ;
    skos:prefLabel "baryte"@en ;
    schema:citation
        "http://en.wikipedia.org/wiki/Baryte"^^xsd:anyURI ,
        "https://glossary.americangeosciences.org/term/barite"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:basalt
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "bluestone"@en ,
        "trap rock"@en ;
    skos:broader :mafic-igneous-rock ;
    skos:definition "As a commodity, a general term for fine-grained, mafic (dark-coloured) igneous rocks, commonly extrusive (volcanic) but locally intrusive (e.g. as dykes or pipes); also referred to as trap rock. Basalt is composed chiefly of calcic plagioclase and pyroxene (commonly clinopyroxene) and is the fine-grained/aphanitic equivalent of gabbro. Olivine and iron-titanium oxides are very common, and nepheline, orthopyroxene, or quartz may be present. Basalt is crushed for road and housing construction in concrete, macadam, and paving stones. Because of its insensitivity to chemical influences, resistance to mechanical stress, high dry relative density, frost resistance, and seawater resistance, it is used as ballast for railroad track bed and hydraulic engineering rock (riprap) in coast and bank protection for paving embankments. It is also used for the production of cast rock that is used in corrosion and abrasion protection, as for sewage pipes and acid-resistant rocks. Other uses include gardening and landscaping, for the production of millstones, for the production of mineral wool, as a flux in ceramic masses and glazes, for the production of glass ceramics, crushed as a filter aggregate (air filtration of poison gas) in ABC bunkers, as filter bed material at water treatment facilities, and ground as a soil improvement product."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/basalt> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/basalt> ,
        <https://linked.data.gov.au/def/geo-commodities/basalt> ;
    skos:inScheme cs: ;
    skos:prefLabel "mafic igneous rock - basalt"@en ;
    schema:citation
        "https://en.wikipedia.org/wiki/Basalt"^^xsd:anyURI ,
        "https://www.mindat.org/min-48492.html"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:bentonite
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "Fullers earth"@en ,
        "amargosite"@en ,
        "clay"@en ,
        "mineral soap"@en ,
        "smectite claystone"@en ,
        "smectite-claystone"@en ,
        "soap clay"@en ,
        "volcanic clay"@en ;
    skos:broadMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/Fullersearth> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/Fullersearth> ,
        <https://linked.data.gov.au/def/geo-commodities/fullers-earth> ;
    skos:broader :mineral-commodities ;
    skos:definition "Soft clay or greasy claystone composed largely of the aluminium phyllosilicate montmorillonite formed from the chemical alteration of glassy volcanic ash in contact with water. It usually contains accessory crystal grains that were originally phenocrysts in the parent rock. Bentonite has the ability to absorb large quantities of water accompanied by a large increase in volume that can result in a thixotropic gel. The main uses of bentonite are in drilling mud and as a binder, purifier, absorbent, and carrier for fertilizers or pesticides. Minor uses include filler, sealant, and as a catalyst in petroleum refining. Calcium bentonite is sometimes marketed as Fuller's earth, whose uses overlap with those of other forms of bentonite."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/bentonite> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/bentonite> ,
        <https://linked.data.gov.au/def/geo-commodities/bentonite> ;
    skos:inScheme cs: ;
    skos:prefLabel "bentonite"@en ;
    schema:citation
        "https://en.wikipedia.org/wiki/Bentonite#Applications"^^xsd:anyURI ,
        "https://glossary.americangeosciences.org/term/bentonite"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

