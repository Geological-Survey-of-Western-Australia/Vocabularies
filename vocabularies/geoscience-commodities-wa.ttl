    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:marble
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broader :industrial-commodities ;
    skos:definition "As a commodity, any crystalline carbonate rock, including true marble and certain types of limestone (orthomarble, travertine), that will take a polish and can be used as architectural or ornamental stone. Note that the usage of the term marble in this sense is different from the formally classified metamorphic rock type (i.e. a metamorphic rock containing more than 50% volume of carbonate minerals (calcite and/or aragonite and/or dolomite, with pure marble containing more than 95% volume of carbonate minerals)."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/marble> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/marble> ,
        <https://linked.data.gov.au/def/geo-commodities/marble> ;
    skos:inScheme cs: ;
    skos:prefLabel "marble"@en ;
    schema:citation
        "https://en.wikipedia.org/wiki/Marble"^^xsd:anyURI ,
        "https://glossary.americangeosciences.org/term/marble"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:metal-equivalents
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broader :rer-parameters ;
    skos:definition "Metal equivalents provide a useful and concise indication of the value of mineralisation that contains more than one valuable metal or mineral. They provide a single number that reflects the contributions of two or more assay results, providing a simpler presentation of information. Calculation of metal equivalent is dependent on assay data, metal/mineral pricing and metallurgical recoveries."@en ;
    skos:historyNote """Adapted from:
Rose, S and Fahey, G, 2019. The use and abuse of metal equivalents, in Proceedings Mining Geology 2019, p. 8187 (The Australasian Institute of Mining and Metallurgy: Melbourne).""" ;
    skos:inScheme cs: ;
    skos:narrower
        :copper-equivalent ,
        :gold-equivalent-ounce ,
        :nickel-equivalent ;
    skos:prefLabel "metal equivalents"@en ;
    schema:citation "https://www.ausimm.com/publications/conference-proceedings/11th-international-mining-geology-conference-2019/the-use-and-abuse-of-metal-equivalents/"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:nickel
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "Ni"@en ;
    skos:broader :mineral-commodities ;
    skos:definition "A chemical element with symbol Ni and atomic number 28. It is a silvery-white lustrous metal with a slight golden tinge. Nickel is a hard and ductile transition metal. An economically important source of nickel is the iron ore limonite, which is often 1–2% nickel. Other important nickel ore minerals include pentlandite and a mix of Ni-rich natural silicates known as garnierite. The metal is used chiefly in alloys and corrosion-resistant plating, as well as rechargeable batteries and coins."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/nickel> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/nickel> ,
        <https://linked.data.gov.au/def/geo-commodities/nickel> ;
    skos:inScheme cs: ;
    skos:narrowMatch <https://linked.data.gov.au/def/geo-commodities/nickel-ore> ;
    skos:prefLabel "nickel"@en ;
    schema:citation "https://en.wikipedia.org/wiki/Nickel"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:nitric-acid
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "aqua fortis"@en ,
        "hydrogen nitrate"@en ,
        "spirit of niter"@en ;
    skos:broader :industrial-commodities ;
    skos:definition "An inorganic compound with the chemical formula HNO₃. It is a highly corrosive mineral acid. Nitric acid is the primary reagent used for nitration — the addition of a nitro group, typically to an organic molecule. While some resulting nitro compounds are shock- and thermally sensitive explosives, a few are stable enough to be used in munitions and demolition, while others are still more stable and used as pigments in inks and dyes. Nitric acid is also commonly used as a strong oxidizing agent."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "nitric acid"@en ;
    schema:citation "https://en.wikipedia.org/wiki/Nitric_acid"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:opal
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broadMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/gemstone> ,
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/silica-gemstone> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/gemstone> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/silica-gemstone> ,
        <https://linked.data.gov.au/def/geo-commodities/gemstone> ,
        <https://linked.data.gov.au/def/geo-commodities/silica-gemstone> ;
    skos:broader :mineral-commodities ;
    skos:definition "A hydrated amorphous form of silica (SiO₂·nH₂O), with water content ranging from 3 to 21% by weight but usually between 6 and 10%. Opal is not a true mineral in the accepted sense of the word as it is variably composed of poorly crystalline material related to cristobalite and/or tridymite and/or composed of X-Ray amorphous silica; it is commonly considered a mineraloid due to its amorphous nature but is more like a mixture due to its common but variable paracrystalline components. It occurs in nearly all colours, is transparent to nearly opaque and typically exhibits a marked iridescent play of colour. Opal is deposited at a relatively low temperature from silica-bearing water, and may occur in the fissures of almost any kind of rock, being most commonly found cracks and cavities of igneous rocks, in flintlike nodules in limestones, in mineral veins, in deposits of thermal springs, in siliceous skeletons of various marine organisms (such as diatoms and sponges), in serpentinized rocks, in weathering products, and in most chalcedony and flint. The transparent coloured varieties exhibiting opalescence are prized as gemstones. Opal usually occurs in massive form and frequently pseudomorphs other minerals."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/opal> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/opal> ,
        <https://linked.data.gov.au/def/geo-commodities/opal> ;
    skos:inScheme cs: ;
    skos:narrowMatch
        <https://linked.data.gov.au/def/geo-commodities/black-opal> ,
        <https://linked.data.gov.au/def/geo-commodities/boulder-opal> ,
        <https://linked.data.gov.au/def/geo-commodities/matrix-opal> ,
        <https://linked.data.gov.au/def/geo-commodities/white-opal> ;
    skos:narrower
        :opal-common ,
        :opal-gem ;
    skos:prefLabel "opal"@en ;
    schema:citation
        "https://en.wikipedia.org/wiki/Opal"^^xsd:anyURI ,
        "https://glossary.americangeosciences.org/term/opal"^^xsd:anyURI ,
        "https://www.mindat.org/min-3004.html"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:opal-common
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broadMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/gemstone> ,
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/opal> ,
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/silica-gemstone> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/gemstone> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/opal> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/silica-gemstone> ,
        <https://linked.data.gov.au/def/geo-commodities/gemstone> ,
        <https://linked.data.gov.au/def/geo-commodities/opal> ,
        <https://linked.data.gov.au/def/geo-commodities/silica-gemstone> ;
    skos:broader :opal ;
    skos:definition "A variety of opal that does not display iridescence, instead displaying a hazy, milky, turbid sheen from within the stone called opalescence. Types of common opal include the milk opal, resin opal, wood opal, menilite, hyalite (sometimes called Muller's glass), geyserite (also called siliceous sinter, deposited around hot springs or geysers) and diatomaceous earth."@en ;
    skos:inScheme cs: ;
    skos:narrower
        :opal-moss ,
        :opal-siliciophite ;
    skos:prefLabel "opal - common"@en ;
    schema:citation "https://en.wikipedia.org/wiki/Opal"^^xsd:anyURI ;
