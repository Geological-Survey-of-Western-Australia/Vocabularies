:tantalum
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "Ta"@en ;
    skos:broader :mineral-commodities ;
    skos:definition "Tantalum is a chemical element with the symbol Ta and atomic number 73. Tantalum is a very hard, ductile, lustrous, blue-grey transition metal that is highly corrosion-resistant. It is part of the refractory metals group, which are widely used as components of strong high-melting-point alloys. The chemical inertness and very high melting point of tantalum make it valuable for laboratory and industrial equipment such as reaction vessels and vacuum furnaces. It is used in tantalum capacitors for electronic equipment such as computers."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/tantalum> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/tantalum> ,
        <https://linked.data.gov.au/def/geo-commodities/tantalum> ;
    skos:inScheme cs: ;
    skos:prefLabel "tantalum"@en ;
    schema:citation "https://en.wikipedia.org/wiki/Tantalum"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:tantalum-pentoxide
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "Ta oxide"@en ,
        "Ta-oxide"@en ,
        "ditantalum pentaoxide"@en ,
        "tantalum oxide"@en ,
        "tantalum(V) oxide"@en ;
    skos:broader :mineral-commodities ;
    skos:definition "Tantalum pentoxide is the inorganic compound with the formula Ta₂O₅. It is a white solid that is insoluble in all solvents but is attacked by strong bases and hydrofluoric acid. Tantalum pentoxide is an inert material with a high refractive index and low absorption (i.e. colourless), which makes it useful for coatings. It is also extensively used in the production of capacitors, due to its high dielectric constant."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/tantalumpentoxide> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/tantalumpentoxide> ,
        <https://linked.data.gov.au/def/geo-commodities/tantalum-pentoxide> ;
    skos:inScheme cs: ;
