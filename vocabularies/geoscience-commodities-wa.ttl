:limestone-metallurgical
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broadMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/limestone> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/limestone> ,
        <https://linked.data.gov.au/def/geo-commodities/limestone> ;
    skos:broader :limestone ;
    skos:definition "A carbonate sedimentary rock containing more than 95% calcite and less than 5% dolomite and used for metallurgical processes. Limestone is used in steel manufacturing, beneficiation of copper ore, to make alumina and magnesia for use in aluminium and magnesium manufacturing, to extract uranium and to recover gold and silver."@en ;
    skos:inScheme cs: ;
