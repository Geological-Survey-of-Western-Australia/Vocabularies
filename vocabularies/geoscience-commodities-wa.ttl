:azurite
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "blue copper ore"@en ,
        "chessylite"@en ;
    skos:broadMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/gemstone> ,
