    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:sodium-cyanide
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broader :mineral-commodities ;
    skos:definition "Sodium cyanide is a poisonous compound with the chemical formula NaCN. It is a white, water-soluble solid. Cyanide has a high affinity for metals, which leads to the high toxicity of this salt. Its main application, in gold mining, also exploits its high reactivity toward metals. It is a moderately strong base."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "sodium cyanide"@en ;
    schema:citation "https://en.wikipedia.org/wiki/Sodium_cyanide"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:soil-loam
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "loam"@en ;
    skos:broadMatch <https://linked.data.gov.au/def/geo-commodities/horticultural-sand> ;
    skos:broader :industrial-commodities ;
    skos:definition "The unconsolidated mineral or organic material on the immediate surface of the earth that serves as a natural medium for the growth of land plants. Soil is used in agriculture, where it serves as the anchor and primary nutrient base for plants.  Note that the term loam is often used loosely to refer to soil, but can also refer to a specific soil textural class consisting of 7-27% clay, 28-50% silt, and < 52% sand (or 40–40–20% concentration of sand–silt–clay by weight)."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "soil/loam"@en ;
    schema:citation
