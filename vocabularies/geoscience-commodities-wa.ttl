.

:fluorite
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "Derbyshire spar"@en ,
        "calcium fluoride"@en ,
        "fluor"@en ,
        "fluorspar"@en ;
    skos:broader :mineral-commodities ;
    skos:definition "A transparent to translucent mineral with the chemical formula CaF₂. It is found in many different colours (most commonly blue or purple) and has a hardness of 4 on the Mohs scale. Fluorite occurs in veins, usually as a gangue mineral associated with lead, tin, and zinc ores, and is commonly found in crystalline cubes with perfect octahedral cleavage. It is the principal ore of fluorine, and is used as a flux, in the preparation of glass and enamel, in the manufacture of hydrofluoric acid, and for carved ornamental objects."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/fluorite> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/fluorite> ,
        <https://linked.data.gov.au/def/geo-commodities/fluorite> ;
    skos:inScheme cs: ;
