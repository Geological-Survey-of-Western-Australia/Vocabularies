    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:tantalite-and-columbite
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "coltan"@en ;
    skos:broader :mineral-commodities ;
    skos:definition "Tantalite and columbite are the tantalum and niobium end-members of a group of minerals that have varying amounts of iron, manganese, niobium, and tantalum in a generic formula (Fe,Mn)(Nb,Ta)₂O₆. They are found as platy, black grains in pegmatites."@en ;
    skos:inScheme cs: ;
    skos:narrower
