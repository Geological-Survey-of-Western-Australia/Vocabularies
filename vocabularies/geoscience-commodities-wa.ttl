:gaspeite
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "gaspéite"@en ;
    skos:broader :mineral-commodities ;
    skos:definition "A light green rhombohedral mineral with the chemical formula (Ni,Mg)CO₃. A member of the calcite group, gaspeite occurs in translucent bright grass-green to olive or yellowish green nodular concretions or as aggregates of rhombic crystals. Gaspeite is used for sculpture and cut into cabochons for jewellery."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "gaspeite"@en ;
    schema:citation
        "https://glossary.americangeosciences.org/term/gaspeite"^^xsd:anyURI ,
        "https://www.gemdat.org/gem-1657.html"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:geothermal-energy
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broadMatch <https://linked.data.gov.au/def/geo-commodities/energy-resources> ;
    skos:broader :power-energy ;
    skos:definition "Geothermal energy is the thermal energy in the Earth's crust that originates from the formation of the planet and from radioactive decay of materials. Technologies in use to harness geothermal energy include dry steam power stations, flash steam power stations and binary cycle power stations. Geothermal energy is considered to be a sustainable, renewable source of energy because the heat extraction is small compared with the Earth's heat content."@en ;
    skos:exactMatch <https://linked.data.gov.au/def/geo-commodities/geothermal-energy> ;
    skos:historyNote "Definition from the Australian Renewable Energy Agency (ARENA) and Wikipedia." ;
    skos:inScheme cs: ;
    skos:prefLabel "geothermal energy"@en ;
    schema:citation
        "https://arena.gov.au/renewable-energy/geothermal/"^^xsd:anyURI ,
        "https://en.wikipedia.org/wiki/Geothermal_energy"^^xsd:anyURI ,
        "https://en.wikipedia.org/wiki/Geothermal_power"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:germanium
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broader :mineral-commodities ;
    skos:definition "A chemical element with symbol Ge and atomic number 32. It is a lustrous, hard, greyish-white metalloid in the carbon group, chemically similar to its group neighbours tin and silicon. Purified germanium is a semiconductor, with an appearance most similar to elemental silicon. Germanium naturally reacts and forms complexes with oxygen in nature but is too reactive to be found naturally on Earth in the free (native) state."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/germanium> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/germanium> ,
        <https://linked.data.gov.au/def/geo-commodities/germanium> ;
    skos:inScheme cs: ;
    skos:prefLabel "germanium"@en ;
    schema:citation "https://en.wikipedia.org/wiki/Germanium"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:gold-equivalent-ounce
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broader :metal-equivalents ;
    skos:definition "Gold Equivalent Ounce (GEO) is a calculated parameter used in the mining industry to standardize the production of different metals by converting them into the equivalent amount of gold, to assist investors and analysts in comparing the production of mines that produce multiple metals (gold would normally be the primary metal produced)."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "gold equivalent ounce (GEO)"@en ;
    schema:citation
        "https://au.finance.yahoo.com/news/gold-equivalent-ounce-geo-010200717.html"^^xsd:anyURI ,
        "https://www.fool.com/investing/2018/05/21/what-is-a-gold-equivalent-ounce-geo.aspx"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:graphite
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broader :industrial-commodities ;
    skos:definition "A naturally occurring, hexagonal crystalline mineral dimorphous with diamond and comprised entirely of carbon. It is opaque, lustrous, greasy to the touch, and iron black to steel grey in colour. Graphite occurs as crystals, flakes, scales, laminae or grains in veins or bedded masses or as disseminations in metamorphic rocks. Graphite conducts electricity well, and is soft and unctuous, immune to most acids, and extremely refractory. It is used in 'lead' pencils, paints and crucibles, as a lubricant and an electrode, and as a moderator in nuclear reactors."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/graphite> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/graphite> ,
        <https://linked.data.gov.au/def/geo-commodities/graphite> ;
    skos:inScheme cs: ;
    skos:prefLabel "graphite"@en ;
    schema:citation "https://glossary.americangeosciences.org/term/graphite"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:gravel-pisolitic
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "pisolitic gravel"@en ;
    skos:broader :gravel ;
    skos:definition "An unconsolidated, natural accumulation of rounded rock fragments called pisoids (or pisoliths). i.e. round or ellipsoidal concretionary grains typically formed of calcium carbonate or Fe-rich minerals that resemble ooids but are more than 2 mm in diameter. These grains are approximately spherical and have concentric layers reaching 10 mm in diameter. Commonly used as a form of pea gravel for landscaping purposes."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "gravel - pisolitic"@en ;
    schema:citation
        "https://glossary.americangeosciences.org/term/pisoid"^^xsd:anyURI ,
        "https://www.mindat.org/min-26778.html"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:grunerite
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broader :mineral-commodities ;
    skos:definition "A green, brown, or grey monoclinic mineral of the amphibole group with the chemical formula Fe²⁺₂(Fe²⁺,Mg)₅Si₈O₂₂(OH)₂. It is the iron end-member of the grunerite–cummingtonite series and forms fibrous, columnar or massive aggregates of crystals. Grunerite is common mineral in medium- to high-grade metamorphosed iron formations and also occurs as a product of contact metamorphism, and in some blueschist facies quartzites. The fibrous (asbestiform) form of grunerite, amosite, is known to be a respirable carcinogen."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "grunerite"@en ;
    schema:citation
        "https://en.wikipedia.org/wiki/Grunerite"^^xsd:anyURI ,
        "https://glossary.americangeosciences.org/term/grunerite"^^xsd:anyURI ,
        "https://www.mindat.org/min-1758.html"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:hafnium
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broader :mineral-commodities ;
    skos:definition "A chemical element with the symbol Hf and atomic number 72. A lustrous, silvery grey, tetravalent transition metal, hafnium chemically resembles zirconium and is found in zirconium minerals. Hafnium is used in filaments and electrodes as well as in the manufacture of control rods for nuclear reactors."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/hafnium> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/hafnium> ,
        <https://linked.data.gov.au/def/geo-commodities/hafnium> ;
    skos:inScheme cs: ;
    skos:prefLabel "hafnium"@en ;
    schema:citation "https://en.wikipedia.org/wiki/Hafnium"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:hafnium-oxide
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "Hf oxide"@en ,
        "Hf-oxide"@en ,
        "hafnia"@en ,
        "hafnium dioxide"@en ,
        "hafnium(IV) oxide"@en ,
        "hafnium-dioxide"@en ,
        "hafnium-oxide"@en ;
    skos:broader :mineral-commodities ;
    skos:definition "An inorganic compound with the formula HfO₂. Hafnium oxide is a colourless solid, and one of the most common and stable compounds of hafnium. Hafnium oxide is used in optical coatings, and as a high-κ dielectric in DRAM capacitors and in advanced metal–oxide–semiconductor devices."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/hafniumoxide> ,
