        "dravite"@en ;
    skos:broadMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/tourmaline> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/tourmaline> ,
        <https://linked.data.gov.au/def/geo-commodities/tourmaline> ;
    skos:broader :tourmaline ;
    skos:definition "A pale brown to dark-brown to brown-black, magnesium-rich rhombohedral mineral of the tourmaline group with the chemical formula NaMg₃Al₆(BO₃)₃Si₆O₁₈(OH)₄. Forms an end member of the dravite–elbaite series and the dravite–schorl series. Dravite typically forms in metamorphic environments."@en ;
    skos:inScheme cs: ;
    skos:narrower :tourmaline-elbaite ;
