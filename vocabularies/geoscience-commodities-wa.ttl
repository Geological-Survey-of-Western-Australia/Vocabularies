    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:potassium-mg-sulfate
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "SOPM"@en ,
        "langbeinite"@en ,
        "sulphate of potash magnesia"@en ;
    skos:broadMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/potash> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/potash> ,
        <https://linked.data.gov.au/def/geo-commodities/potash> ;
    skos:broader :potash ;
    skos:definition "Potassium magnesium sulfate is a double salt that can crystallize in a number of forms occurring as the minerals langbeinite K₂Mg₂(SO₄)₃, leonite K₂Mg(SO₄)₂·4H₂O and picromerite K₂Mg(SO₄)₂·6H₂O. Langbeinite is the most common of the three, and is an ore of potassium found in marine evaporate deposits in association with carnallite, halite and sylvite. Also referred to as sulphate of potash magnesia (SOPM)."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "potash - potassium magnesium sulfate (SOPM, K2SO4-Mg2SO4)"@en ;
    schema:citation
        "https://en.wikipedia.org/wiki/Potassium_magnesium_sulfate"^^xsd:anyURI ,
