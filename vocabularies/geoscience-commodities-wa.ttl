        "https://linked.data.gov.au/def/geo-commodities/manganese-ore"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:methanol
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "MeOH"@en ,
        "methyl alcohol"@en ,
        "wood spirit"@en ;
    skos:broader :energy-commodities ;
    skos:definition "An organic chemical and the simplest aliphatic alcohol, with the chemical formula CH₃OH (a methyl group linked to a hydroxyl group, often abbreviated as MeOH). It is a light, volatile, colourless and flammable liquid with a distinctive alcoholic odour similar to that of ethanol (potable alcohol). Methanol is mainly produced industrially by hydrogenation of carbon monoxide and has numerous roles including as an amphiprotic solvent, a fuel, a human metabolite, an Escherichia coli metabolite, a mouse metabolite and a Mycoplasma genitalium metabolite."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "methanol (MeOH)"@en ;
    schema:citation
        "https://en.wikipedia.org/wiki/List_of_abbreviations_in_oil_and_gas_exploration_and_production"^^xsd:anyURI ,
        "https://en.wikipedia.org/wiki/Methanol"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:molybdenite
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broader :mineral-commodities ;
    skos:definition "A soft platy lead-grey mineral crystallizing in hexagonal and rhombohedral polytypes with the chemical formula MoS₂. It is the principal ore of molybdenum. Molybdenite generally occurs in foliated masses or scales, and is found in pegmatite dykes and quartz veins or disseminated in porphyry. It resembles graphite in appearance and to the touch but has a bluer colour."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/molybdenite> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/molybdenite> ,
        <https://linked.data.gov.au/def/geo-commodities/molybdenite> ;
    skos:inScheme cs: ;
    skos:prefLabel "molybdenite"@en ;
    schema:citation
        "https://en.wikipedia.org/wiki/Molybdenite"^^xsd:anyURI ,
        "https://glossary.americangeosciences.org/term/molybdenite"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:monazite
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broader :mineral-commodities ;
    skos:definition "A group of minerals with the general chemical formula REE(PO4). Members of the Monazite Group with dominant REE and P include: monazite-(Ce), monazite-(La), monazite-(Nd), monazite-(Sm) and monazite-(Gd). The great majority of 'monazite' is monazite-(Ce), the La-, Nd-, Sm- and Gd-dominant members are all very rare. Monazite usually contains small amounts of Th or sometimes U, both making it radioactive. It is widely disseminated as an accessory mineral in granite, gneiss and pegmatite, and it is often naturally concentrated in detrital sand (heavy mineral sand), gravel and alluvial tin deposits. Monazite is a principal ore of the rare earths and the main source of thorium."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/monazite> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/monazite> ,
        <https://linked.data.gov.au/def/geo-commodities/monazite> ;
    skos:inScheme cs: ;
    skos:prefLabel "monazite"@en ;
    schema:citation
        "http://en.wikipedia.org/wiki/Monazite"^^xsd:anyURI ,
        "https://glossary.americangeosciences.org/term/monazite"^^xsd:anyURI ,
        "https://www.mindat.org/min-2750.html"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:mookaite
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broadMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/gemstone> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/gemstone> ,
        <https://linked.data.gov.au/def/geo-commodities/gemstone> ;
    skos:broader :mineral-commodities ;
    skos:definition "A varicoloured opaline to chalcedonic variety of radiolarite, a siliceous, comparatively hard, fine-grained, chert-like, and homogeneous sedimentary rock that is composed predominantly of the microscopic remains of radiolarians. Mookaite is locally mined for use as an ornamental stone from near Mooka, Western Australia, from the Windalia radiolarite, a Lower Cretaceous formation."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "mookaite"@en ;
    schema:citation "https://en.wikipedia.org/wiki/Radiolarite"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:moonstone
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "hecatolite"@en ;
    skos:broadMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/gemstone> ,
