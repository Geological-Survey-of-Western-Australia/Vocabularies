:barium
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broader :mineral-commodities ;
    skos:definition "A chemical element with symbol Ba and atomic number 56. It is a silvery-white, metallic element, belonging to the alkaline earth group. Because of its high chemical reactivity, barium is never found in nature as a free element. It is found chiefly in baryte and witherite. All barium compounds that are water or acid soluble are poisonous. Barium is used in paint, X-ray diagnostic work, glassmaking, oil well drilling fluids and pyrotechny."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/barium> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/barium> ,
        <https://linked.data.gov.au/def/geo-commodities/barium> ;
    skos:inScheme cs: ;
    skos:prefLabel "barium"@en ;
    schema:citation "http://en.wikipedia.org/wiki/Barium"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:baryte
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "barite"@en ,
        "barium sulfate"@en ,
        "barium sulphate"@en ,
        "cawk"@en ,
        "heavy spar"@en ;
    skos:broader :mineral-commodities ;
    skos:definition "A white, yellow or colourless, orthorhombic barium sulfate mineral with the chemical formula BaSO₄. Strontium and calcium are often present. Baryte occurs in tabular crystals, in granular form, or in compact masses resembling marble, and has a specific gravity of 4.5. It is used in paint, as a weighting agent in petroleum well drilling mud, and as a filler for paper and textiles, and is the principal ore of barium."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/baryte> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/baryte> ,
