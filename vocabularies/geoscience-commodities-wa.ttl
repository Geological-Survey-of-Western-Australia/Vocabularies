:electrolytic-manganese-dioxide
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "EMD"@en ,
        "electrolytic manganese dioxide"@en ;
    skos:broader :manganese ;
    skos:definition "Electrolytic manganese dioxide (EMD) is manganese dioxide (MnO₂) that is produced through electrowinning, i.e. by dissolving manganese dioxide in sulfuric acid and applying a current between two electrodes — manganese dioxide dissolves, enters solution as the sulfate, and is deposited on the anode. EMD is used primarily as the active constituent of alkaline batteries and increasingly as the feedstock for the cathodic material in lithium-ion batteries."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "manganese - electrolytic manganese dioxide (EMD)"@en ;
    schema:citation "https://en.wikipedia.org/wiki/Manganese_dioxide"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:erbium
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broadMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/HREE> ,
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/rareearthelement> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/HREE> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/rareearthelement> ,
        <https://linked.data.gov.au/def/geo-commodities/heavy-rare-earth-element> ,
        <https://linked.data.gov.au/def/geo-commodities/rare-earth-element> ;
    skos:broader :heavy-rare-earth-elements ;
    skos:definition "Erbium is a chemical element with the symbol Er and atomic number 68. A silvery-white solid metal when artificially isolated, natural erbium is always found in chemical combination with other elements. It is a lanthanide, a rare (REE) earth element. Erbium is principally used in certain laser applications as well as in a large variety of medical applications."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/erbium> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/erbium> ,
        <https://linked.data.gov.au/def/geo-commodities/erbium> ;
    skos:inScheme cs: ;
    skos:prefLabel "erbium"@en ;
    schema:citation "https://en.wikipedia.org/wiki/Erbium"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:erbium-oxide
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "Er oxide"@en ,
        "Er(III) oxide"@en ,
        "Er(III)-oxide"@en ,
        "Er-oxide"@en ,
        "erbia"@en ,
        "erbium(III) oxide"@en ,
        "erbium-oxide"@en ;
    skos:broadMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/heavyrareearthoxide> ,
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/rareearthoxide> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/heavyrareearthoxide> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/rareearthoxide> ,
        <https://linked.data.gov.au/def/geo-commodities/heavy-rare-earth-oxide> ,
        <https://linked.data.gov.au/def/geo-commodities/rare-earth-oxide> ;
    skos:broader :rare-earth-oxides ;
    skos:definition "Erbium oxide is the inorganic compound with the chemical formula Er₂O₃. It is a pink paramagnetic solid used in various optical materials. Erbium oxide is among the most important rare earth metals used in biomedicine. The photoluminescence property of erbium oxide nanoparticles on carbon nanotubes makes them useful in biomedical applications. For example, erbium oxide nanoparticles can be surface modified for distribution into aqueous and non-aqueous media for bioimaging. Erbium oxides are also used as gate dielectrics in semiconductor devices since it has a high dielectric constant (10–14) and a large band gap. Erbium is sometimes used as a colouring for glasses and erbium oxide can also be used as a burnable neutron poison for nuclear fuel."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "erbium oxide"@en ;
    schema:citation "https://en.wikipedia.org/wiki/Erbium(III)_oxide"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:eucryptite
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broader :mineral-commodities ;
    skos:definition "A colourless or white rhombohedral mineral of the phenakite group with the chemical formula LiAlSiO₄. Eucryptite occurs in lithium-rich pegmatites, usually as graphic intergrowths with albite derived from alteration of spodumene."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "eucryptite"@en ;
    schema:citation
