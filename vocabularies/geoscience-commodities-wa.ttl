    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:hydrogen-manufactured
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "manufactured hydrogen"@en ;
    skos:broader :hydrogen ;
    skos:definition "Hydrogen gas produced mainly from steam reforming of natural gas or oil reforming (blue or grey hydrogen, depending on whether greenhouse gases are captured or not), or coal gasification (black or brown hydrogen depending on the type of coal used). A small percentage is also produced using more energy-intensive methods such as the electrolysis of water. Most hydrogen is used near the site of its production."@en ;
    skos:inScheme cs: ;
