    schema:citation "https://glossary.americangeosciences.org/term/rhodonite"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:rubidium
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broader :mineral-commodities ;
    skos:definition "Rubidium is the chemical element with the symbol Rb and atomic number 37. It is a very soft, whitish grey solid in the alkali metal group. Rubidium's compounds have various chemical and electronic applications. Rubidium metal is easily vaporised and has a convenient spectral absorption range, making it a frequent target for laser manipulation of atoms."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/rubidium> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/rubidium> ,
        <https://linked.data.gov.au/def/geo-commodities/rubidium> ;
    skos:inScheme cs: ;
    skos:prefLabel "rubidium"@en ;
    schema:citation "https://en.wikipedia.org/wiki/Rubidium"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:rubidium-oxide
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "Rb oxide"@en ,
        "Rb-oxide"@en ,
        "dirubidium oxide"@en ,
        "rubidium(I) oxide"@en ;
    skos:broader :mineral-commodities ;
    skos:definition "Rubidium oxide is a yellow-coloured solid chemical compound with the formula Rb₂O. Rubidium oxide is highly reactive towards water, and therefore it would not be expected to occur naturally. The rubidium content in minerals is often calculated and quoted in terms of Rb₂O. In reality, the rubidium is typically present as a component of (actually, an impurity in) silicate or aluminosilicate."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "rubidium oxide"@en ;
    schema:citation "https://en.wikipedia.org/wiki/Rubidium_oxide"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:ruthenium
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broader :platinum-group-elements ;
    skos:definition "Ruthenium is a chemical element with the symbol Ru and atomic number 44. It is a rare transition metal belonging to the platinum group of the periodic table. Like the other metals of the platinum group, ruthenium is inert to most other chemicals. Ruthenium is usually found as a minor component of platinum ores. Most ruthenium produced is used in wear-resistant electrical contacts and thick-film resistors. A minor application for ruthenium is in platinum alloys and as a chemistry catalyst."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/ruthenium> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/ruthenium> ,
        <https://linked.data.gov.au/def/geo-commodities/ruthenium> ;
    skos:inScheme cs: ;
    skos:prefLabel "ruthenium"@en ;
    schema:citation "https://en.wikipedia.org/wiki/Ruthenium"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:rutile
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "red schorl"@en ;
    skos:broader :titanium-dioxide ;
    skos:definition "A usually reddish brown tetragonal mineral with the chemical formula TiO₂. It is trimorphous with anatase and brookite, and often contains a little iron. Rutile forms prismatic crystals in other minerals (particularly quartz). It occurs as a primary mineral in some acid igneous rocks, in metamorphic rocks, and as residual grains in sediments and beach sands. It is an ore of titanium and used as an opacifier in ceramics."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/rutile> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/rutile> ,
        <https://linked.data.gov.au/def/geo-commodities/rutile> ;
    skos:inScheme cs: ;
