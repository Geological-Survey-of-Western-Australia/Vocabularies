:sand-construction
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "construction sand"@en ;
    skos:broadMatch <https://linked.data.gov.au/def/geo-commodities/sand> ;
    skos:broader :sand ;
    skos:definition "Sand destined for the construction industry, as an essential material used for a variety of applications including concrete production, asphalt, and road base. Common uses include internal and external rendering, infill or packing, as well as brick and block laying. The properties and quality of construction sand directly influence the strength, durability, and overall effectiveness of construction projects. Subtypes include river sand, concrete sand, M-sand (manufactured sand), fill sand, pit sand, utility sand."@en ;
    skos:inScheme cs: ;
    skos:narrowMatch
        <https://linked.data.gov.au/def/geo-commodities/asphalt-sand> ,
        <https://linked.data.gov.au/def/geo-commodities/manufactured-sand> ,
        <https://linked.data.gov.au/def/geo-commodities/mortar-sand> ,
        <https://linked.data.gov.au/def/geo-commodities/other-sand> ,
        <https://linked.data.gov.au/def/geo-commodities/plaster-sand> ,
        <https://linked.data.gov.au/def/geo-commodities/pre-cast-concrete-sand> ,
        <https://linked.data.gov.au/def/geo-commodities/pre-mix-concrete-sand> ;
    skos:narrower :sand-foundry ;
    skos:prefLabel "sand - construction"@en ;
    schema:citation
        "https://alsyedconstruction.com/what-is-construction-sand-a-comprehensive-guide/"^^xsd:anyURI ,
        "https://build-construct.com/building/building-material/construction-sand/"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:sand-undifferentiated
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broadMatch <https://linked.data.gov.au/def/geo-commodities/sand> ;
    skos:broader :sand ;
    skos:definition "A loose aggregate of unlithified mineral or rock particles of sand size (i.e. an unconsolidated or moderately consolidated sedimentary deposit consisting essentially of medium-grained clastics), but otherwise uncategorized; may include legacy projects for which further information is not available."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "sand - undifferentiated"@en ;
    schema:citation "https://glossary.americangeosciences.org/term/sandsed"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:sandstone
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broader :industrial-commodities ;
    skos:definition "A medium-grained clastic sedimentary rock composed of abundant rounded or angular fragments of sand size with or without a fine-grained matrix (silt or clay) and more or less firmly united by a cementing material (commonly silica, iron oxide or calcium carbonate). Sandstone is the consolidated equivalent of sand, intermediate in grain size between conglomerate and mudstone. The sand particles are predominantly quartz, and the term \"sandstone\", when used without qualification, indicates a rock containing about 85–90% quartz. The rock varies in colour, may be deposited by water or wind, and may contain numerous primary features (sedimentary structures and fossils). Sandstone may be classified according to composition of particles, mineralogic or textural maturity, primary structures, and type of cement."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/sandstone> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/sandstone> ,
        <https://linked.data.gov.au/def/geo-commodities/sandstone> ;
    skos:inScheme cs: ;
    skos:prefLabel "sandstone"@en ;
    schema:citation
        "https://en.wikipedia.org/wiki/Sandstone"^^xsd:anyURI ,
        "https://glossary.americangeosciences.org/term/sandstone"^^xsd:anyURI ,
        "https://linked.data.gov.au/def/geo-commodities/sandstone"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:shale
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broader :industrial-commodities ;
    skos:definition "A very fine-grained detrital sedimentary rock formed by the consolidation (particularly by compression) of clay, silt or mud. It is characterized by a finely laminated structure, which imparts a fissility approximately parallel to the bedding, along which the rock breaks readily into thin layers, and by an appreciable content of clay minerals (>66%) and detrital quartz. It is generally soft but sufficiently indurated so that it will not fall apart on wetting; it is less firm than argillite and slate, commonly has a splintery fracture and a smooth feel, and is easily scratched. Its colour may be red, brown, black or grey."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "shale"@en ;
    schema:citation
        "https://glossary.americangeosciences.org/term/shale"^^xsd:anyURI ,
        "https://www.mindat.org/min-49444.html"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:silica-reactive
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broadMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/silica> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/silica> ,
        <https://linked.data.gov.au/def/geo-commodities/silica> ;
    skos:broader :silica ;
    skos:definition "The silica (SiO₂) present within various clay minerals occurring in bauxite. During the Bayer process digestion of bauxite, this silica reacts with comparable amounts of alumina to form insoluble sodium aluminium silicate, which is lost as refinery plant residue."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "silica - reactive"@en ;
    schema:citation
        "https://en.wikipedia.org/wiki/Bayer_process"^^xsd:anyURI ,
        "https://www.mindat.org/glossary/reactive_silica"^^xsd:anyURI ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.

:silica-sand
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broadMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/silica> ,
        <http://resource.geosciml.org/classifier/cgi/commodity-code/silica> ,
        <https://linked.data.gov.au/def/geo-commodities/silica> ;
    skos:broader :silica ;
    skos:definition "An industrial term for a sand or an easily disaggregated sandstone that has a very high percentage of silica (quartz; SiO₂). It is a source of silicon and a raw material of glass and other industrial products."@en ;
    skos:exactMatch
        <http://inspire.ec.europa.eu/codelist/CommodityCodeValue/silicasand> ,
