    gts:ratifiedGSSP true ;
    rdfs:isDefinedBy ds: ;
    skos:broader gtsd:Paleozoic ;
    skos:definition "A time period from 443.1 to 419.62 million years ago"@en ;
    skos:inScheme cs: ;
    skos:narrower
        gtsd:Llandovery ,
        gtsd:Ludlow ,
        gtsd:Pridoli ,
        gtsd:Wenlock ;
    skos:notation "S"^^gtsd:ccgmShortCode ;
    skos:prefLabel "Silurian"@en ;
    time:hasBeginning
        [
            gtsd:inMYA 443.1 ;
            schema:marginOfError 1.0 ;
        ] ;
    time:hasEnd
        [
            gtsd:inMYA 419.62 ;
            schema:marginOfError 1.36 ;
        ] ;
    sh:order 130 ;
    schema:color "#B3E1B6"^^ischart:RGBHex ;
.

