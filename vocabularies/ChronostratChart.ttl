PREFIX cs: <https://data.stratigraphy.org/def/chart>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX ds: <https://data.stratigraphy.org/data/gts>
PREFIX gts: <http://resource.geosciml.org/ontology/timescale/gts#>
PREFIX gtsd: <https://data.stratigraphy.org/data/gts/>
PREFIX ischart: <http://resource.geosciml.org/classifier/ics/ischart/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rank: <http://resource.geosciml.org/ontology/timescale/rank/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <https://schema.org/>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX time: <http://www.w3.org/2006/time#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

ischart:RGBHex
    a owl:Datatype ;
    rdfs:label "RGB colour notation" ;
    rdfs:comment """An 8-bit per channel, hexidecimal representation of RGB colours.

This datatype uses a microformat of "#{R}{G}{B}" with hexidecimal value for {R}, {G} & {B} between 00 and FF."""@en ;
.

gtsd:Ages
    a skos:Collection ;
    rdfs:isDefinedBy ds: ;
    skos:definition "An age is the smallest hierarchical geochronologic unit and is equivalent to a chronostratigraphic stage. These are thousands to millions of years in length"@en ;
    skos:historyNote "This Collection was created from the age ranks of the Chart" ;
    skos:inScheme cs: ;
    skos:member
        gtsd:Aalenian ,
        gtsd:Aeronian ,
        gtsd:Albian ,
        gtsd:Anisian ,
        gtsd:Aptian ,
        gtsd:Aquitanian ,
        gtsd:Artinskian ,
        gtsd:Asselian ,
        gtsd:Bajocian ,
        gtsd:Barremian ,
        gtsd:Bartonian ,
        gtsd:Bashkirian ,
        gtsd:Bathonian ,
        gtsd:Berriasian ,
        gtsd:Burdigalian ,
        gtsd:Calabrian ,
        gtsd:Callovian ,
        gtsd:CambrianStage10 ,
        gtsd:CambrianStage2 ,
        gtsd:CambrianStage3 ,
        gtsd:CambrianStage4 ,
        gtsd:Campanian ,
        gtsd:Capitanian ,
        gtsd:Carnian ,
        gtsd:Cenomanian ,
        gtsd:Changhsingian ,
        gtsd:Chattian ,
        gtsd:Chibanian ,
        gtsd:Coniacian ,
        gtsd:Danian ,
        gtsd:Dapingian ,
        gtsd:Darriwilian ,
        gtsd:Drumian ,
        gtsd:Eifelian ,
        gtsd:Emsian ,
        gtsd:Famennian ,
        gtsd:Floian ,
        gtsd:Fortunian ,
        gtsd:Frasnian ,
        gtsd:Gelasian ,
        gtsd:Givetian ,
        gtsd:Gorstian ,
        gtsd:Greenlandian ,
        gtsd:Guzhangian ,
        gtsd:Gzhelian ,
        gtsd:Hauterivian ,
        gtsd:Hettangian ,
        gtsd:Hirnantian ,
        gtsd:Homerian ,
        gtsd:Induan ,
        gtsd:Jiangshanian ,
        gtsd:Kasimovian ,
        gtsd:Katian ,
        gtsd:Kimmeridgian ,
        gtsd:Kungurian ,
        gtsd:Ladinian ,
        gtsd:Langhian ,
        gtsd:Lochkovian ,
        gtsd:Ludfordian ,
        gtsd:Lutetian ,
        gtsd:Maastrichtian ,
        gtsd:Meghalayan ,
        gtsd:Messinian ,
        gtsd:Moscovian ,
        gtsd:Norian ,
        gtsd:Northgrippian ,
        gtsd:Olenekian ,
        gtsd:Oxfordian ,
        gtsd:Paibian ,
        gtsd:Piacenzian ,
        gtsd:Pliensbachian ,
        gtsd:Pragian ,
        gtsd:Priabonian ,
        gtsd:Pridoli ,
        gtsd:Rhaetian ,
        gtsd:Rhuddanian ,
        gtsd:Roadian ,
        gtsd:Rupelian ,
        gtsd:Sakmarian ,
        gtsd:Sandbian ,
        gtsd:Santonian ,
        gtsd:Selandian ,
        gtsd:Serpukhovian ,
        gtsd:Serravallian ,
        gtsd:Sheinwoodian ,
        gtsd:Sinemurian ,
        gtsd:Telychian ,
        gtsd:Thanetian ,
        gtsd:Tithonian ,
        gtsd:Toarcian ,
        gtsd:Tortonian ,
        gtsd:Tournaisian ,
        gtsd:Tremadocian ,
        gtsd:Turonian ,
        gtsd:UpperPleistocene ,
        gtsd:Valanginian ,
        gtsd:Visean ,
        gtsd:Wordian ,
        gtsd:Wuchiapingian ,
        gtsd:Wuliuan ,
        gtsd:Ypresian ,
        gtsd:Zanclean ;
    skos:prefLabel "Ages"@en ;
.

gtsd:Eons
    a skos:Collection ;
    rdfs:isDefinedBy ds: ;
    skos:definition "An eon is the largest formal geochronologic time unit and is equivalent to a chronostratigraphic eonothem. These are several hundred million years to two billion years in length"@en ;
    skos:historyNote "This Collection was created from the age ranks of the Chart" ;
    skos:inScheme cs: ;
    skos:member
        gtsd:Archean ,
        gtsd:Hadean ,
        gtsd:Phanerozoic ,
        gtsd:Proterozoic ;
    skos:prefLabel "Eons"@en ;
.

gtsd:Epochs
    a skos:Collection ;
    rdfs:isDefinedBy ds: ;
    skos:definition "An epoch is the second smallest geochronologic unit. It is equivalent to a chronostratigraphic series. These are hundreds of thousands to tens of millions of years length"@en ;
    skos:historyNote "This Collection was created from the age ranks of the Chart" ;
    skos:inScheme cs: ;
    skos:member
        gtsd:CambrianSeries2 ,
        gtsd:Cisuralian ,
        gtsd:Eocene ,
        gtsd:Furongian ,
        gtsd:Guadalupian ,
        gtsd:Holocene ,
        gtsd:Llandovery ,
        gtsd:Lopingian ,
        gtsd:LowerCretaceous ,
        gtsd:LowerDevonian ,
        gtsd:LowerJurassic ,
        gtsd:LowerMississippian ,
        gtsd:LowerOrdovician ,
        gtsd:LowerPennsylvanian ,
        gtsd:LowerTriassic ,
        gtsd:Ludlow ,
        gtsd:Miaolingian ,
        gtsd:MiddleDevonian ,
        gtsd:MiddleJurassic ,
        gtsd:MiddleMississippian ,
        gtsd:MiddleOrdovician ,
        gtsd:MiddlePennsylvanian ,
        gtsd:MiddleTriassic ,
        gtsd:Miocene ,
        gtsd:Oligocene ,
        gtsd:Paleocene ,
        gtsd:Pleistocene ,
        gtsd:Pliocene ,
        gtsd:Pridoli ,
        gtsd:Terreneuvian ,
        gtsd:UpperCretaceous ,
        gtsd:UpperDevonian ,
        gtsd:UpperJurassic ,
        gtsd:UpperMississippian ,
        gtsd:UpperOrdovician ,
        gtsd:UpperPennsylvanian ,
        gtsd:UpperTriassic ,
        gtsd:Wenlock ;
    skos:prefLabel "Epochs"@en ;
.

gtsd:Eras
    a skos:Collection ;
    rdfs:isDefinedBy ds: ;
    skos:definition "An era is the second largest geochronologic time unit and is equivalent to a chronostratigraphic erathem. These are tens to hundreds of millions of years in length"@en ;
    skos:historyNote "This Collection was created from the age ranks of the Chart" ;
    skos:inScheme cs: ;
    skos:member
        gtsd:Cenozoic ,
        gtsd:Eoarchean ,
        gtsd:Mesoarchean ,
        gtsd:Mesoproterozoic ,
        gtsd:Mesozoic ,
        gtsd:Neoarchean ,
        gtsd:Neoproterozoic ,
        gtsd:Paleoarchean ,
        gtsd:Paleoproterozoic ,
        gtsd:Paleozoic ;
    skos:prefLabel "Eras"@en ;
.

gtsd:Periods
    a skos:Collection ;
    rdfs:isDefinedBy ds: ;
    skos:definition "A period is equivalent to a chronostratigraphic system. These are millions to tens of millions of years in length"@en ;
    skos:historyNote "This Collection was created from the age ranks of the Chart" ;
    skos:inScheme cs: ;
    skos:member
        gtsd:Calymmian ,
        gtsd:Cambrian ,
        gtsd:Carboniferous ,
        gtsd:Cretaceous ,
        gtsd:Cryogenian ,
        gtsd:Devonian ,
        gtsd:Ectasian ,
        gtsd:Ediacaran ,
        gtsd:Jurassic ,
        gtsd:Neogene ,
        gtsd:Ordovician ,
        gtsd:Orosirian ,
        gtsd:Paleogene ,
        gtsd:Permian ,
        gtsd:Quaternary ,
        gtsd:Rhyacian ,
        gtsd:Siderian ,
        gtsd:Silurian ,
        gtsd:Statherian ,
        gtsd:Stenian ,
        gtsd:Tonian ,
        gtsd:Triassic ;
    skos:prefLabel "Periods"@en ;
.

gtsd:SubPeriods
    a skos:Collection ;
    rdfs:isDefinedBy ds: ;
    skos:definition "A sub-period an informal geochronologic time unit that is only defined for the Carboniferous Period. the two instances are tens of millions of years in length"@en ;
    skos:historyNote "This Collection was created from the age ranks of the Chart" ;
    skos:inScheme cs: ;
    skos:member
        gtsd:Mississippian ,
        gtsd:Pennsylvanian ;
    skos:prefLabel "Sub Periods"@en ;
.

gtsd:SuperEons
    a skos:Collection ;
    rdfs:isDefinedBy ds: ;
    skos:definition "A super eon is an informal time unit that contains all of the eons before any evidence of life. The sole supereon is about two billion years in length"@en ;
    skos:historyNote "This Collection was created from the age ranks of the Chart" ;
    skos:inScheme cs: ;
    skos:member gtsd:Precambrian ;
    skos:prefLabel "Super Eons"@en ;
.

gtsd:inMYA
    a owl:Datatype ;
    rdfs:label "Millions of Years Ago" ;
    rdfs:comment "The expression of a time instant millions of years before the present as a floating point number."@en ;
.

gtsd:Aalenian
    a skos:Concept ;
    gts:rank rank:Age ;
    gts:ratifiedGSSP true ;
    rdfs:isDefinedBy ds: ;
    skos:broader gtsd:MiddleJurassic ;
    skos:definition "A time period from 174.7 to 170.9 million years ago"@en ;
    skos:inScheme cs: ;
    skos:notation "j1"^^gtsd:ccgmShortCode ;
    skos:prefLabel "Aalenian"@en ;
    time:hasBeginning
        [
            gtsd:inMYA 174.7 ;
            schema:marginOfError 0.8 ;
        ] ;
    time:hasEnd
        [
            gtsd:inMYA 170.9 ;
            schema:marginOfError 0.8 ;
        ] ;
    sh:order 58 ;
    schema:color "#9AD9DD"^^ischart:RGBHex ;
.

gtsd:Aeronian
